@@ -2,10 +2,31 @@ package boe
 
 import (
 	"context"
+	_ "embed"
+	"encoding/json"
 
 	"github.com/jmorenobl/kitlegal/internal/core/schema"
 )
 
+// rubricasDelPrototipo es SOLO DEL PROTOTIPO del sondeo previo a H26: las
+// rúbricas de los bloques de dos normas, la LIRPF y la LRJSP, derivadas fuera del
+// binario del texto entero que da la API del BOE (…/id/<norma>/texto) y
+// empotradas aquí, {"<norma>": {"<id>": "<rúbrica>"}}. De las demás normas no hay,
+// y su índice es el de siempre. El hito las obtendrá de la fuente; esto solo da
+// a la sesión la salida que tendría.
+//
+//go:embed proto_rubricas.json
+var rubricasEmpotradas []byte
+
+func rubricasDelPrototipo(norma string) map[string]string {
+	var todas map[string]map[string]string
+	if json.Unmarshal(rubricasEmpotradas, &todas) != nil {
+		return nil
+	}
+
+	return todas[norma]
+}
+
 // Las claves de cada bloque del índice con las que se compone EntradaDeIndice
 // (refs/boe.py 387-388; data-model.md §2.4).
 const (
@@ -51,7 +72,7 @@ func leerIndice(norma string, datos any) (Indice, error) {
 			return Indice{}, campos.err
 		}
 
-		entradas = append(entradas, EntradaDeIndice{ID: id, Titulo: titulo, Tipo: TipoDesdeID(id)})
+		entradas = append(entradas, EntradaDeIndice{ID: id, Titulo: titulo, Rubrica: rubricasDelPrototipo(norma)[id], Tipo: TipoDesdeID(id)})
 	}
 
 	return Indice{Norma: norma, URL: direccionPublicaDeLaNorma(norma), Bloques: entradas}, nil
