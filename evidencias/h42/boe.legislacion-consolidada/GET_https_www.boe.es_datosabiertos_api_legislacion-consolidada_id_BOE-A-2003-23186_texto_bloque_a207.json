    "cuerpo": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<response>\n  <status>\n    <code>200</code>\n    <text>ok</text>\n  </status>\n  <data>\n    <bloque id=\"a207\" tipo=\"precepto\" titulo=\"Artículo 207\">\n      <version id_norma=\"BOE-A-2003-23186\" fecha_publicacion=\"20031218\" fecha_vigencia=\"20040701\">\n        <p class=\"articulo\">Artículo 207. Regulación del procedimiento sancionador en materia tributaria.</p>\n        <p class=\"parrafo\">El procedimiento sancionador en materia tributaria se regulará:</p>\n        <p class=\"parrafo_2\">a) Por las normas especiales establecidas en este título y la normativa reglamentaria dictada en su desarrollo.</p>\n        <p class=\"parrafo\">b) En su defecto, por las normas reguladoras del procedimiento sancionador en materia administrativa.</p>\n      </version>\n    </bloque>\n  </data>\n</response>\n"
