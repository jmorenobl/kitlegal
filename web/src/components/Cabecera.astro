---
// La cabecera: el logotipo, la navegación en una pastilla y el botón de
// instalar. Por debajo de 860 px la navegación se pliega en un menú, que es un
// <details>: se abre y se cierra sin JavaScript, que la página no admite.
import { boton, pagina } from "../lib/clases";
import { REPOSITORIO } from "../lib/proyecto";
import Logo from "./Logo.astro";

interface Props {
  // Página de la audiencia a la que apuntan los enlaces de sección.
  inicio?: string;
}

const { inicio = "/" } = Astro.props;
const ruta = Astro.url.pathname;

const secciones = [
  { texto: "Cómo funciona", destino: `${inicio}#diferencia` },
  { texto: "Garantías", destino: `${inicio}#pilares` },
  { texto: "Consultas", destino: "/consultas/", actual: ruta.startsWith("/consultas/") },
  { texto: "Despachos", destino: "/despachos/", actual: ruta.startsWith("/despachos/") },
  { texto: "GitHub", destino: REPOSITORIO },
];

const menu = [
  { texto: "Inicio", destino: "/", actual: ruta === "/" },
  { texto: "Consultas", destino: "/consultas/", actual: ruta.startsWith("/consultas/") },
  { texto: "Para despachos", destino: "/despachos/", actual: ruta.startsWith("/despachos/") },
  { texto: "Instalar", destino: "/instalar/", actual: ruta.startsWith("/instalar/") },
  { texto: "GitHub", destino: REPOSITORIO },
];

// En la propia página de instalar, el botón va en oscuro.
const enInstalar = ruta.startsWith("/instalar/");
---

<header class:list={[pagina, "relative z-50 flex items-center justify-between gap-3 py-5"]}>
  <a href="/" aria-label="kitlegal, inicio" class="tocable">
    <Logo />
  </a>
  <nav
    aria-label="Secciones"
    class="hidden gap-1.5 rounded-full border border-linea bg-white p-[5px] text-[15px] font-medium min-[860px]:flex"
  >
    {
      secciones.map(({ texto, destino, actual }) => (
        <a
          href={destino}
          aria-current={actual ? "page" : undefined}
          class:list={["tocable rounded-full px-3.5 py-2", actual && "bg-panel text-agente"]}
        >
          {texto}
        </a>
      ))
    }
  </nav>
  <div class="flex items-center gap-2">
    <a href="/instalar/" class={enInstalar ? boton.pequeno.replace("bg-agente", "bg-tinta") : boton.pequeno}>
      Instalar gratis
    </a>
    <details class="group min-[860px]:hidden">
      <summary
        class="tocable flex min-h-11 cursor-pointer list-none items-center rounded-full border border-linea-2 bg-white px-4 text-[15px] font-semibold [&::-webkit-details-marker]:hidden"
      >
        <span class="group-open:hidden">Menú</span>
        <span class="hidden group-open:inline">Cerrar</span>
      </summary>
      <nav
        aria-label="Menú"
        class="absolute inset-x-5 top-full flex flex-col rounded-[20px] border border-linea bg-white p-2 text-[17px] font-semibold shadow-destacada"
      >
        {
          menu.map(({ texto, destino, actual }) => (
            <a
              href={destino}
              aria-current={actual ? "page" : undefined}
              class:list={["tocable rounded-xl px-4 py-3.5", actual && "bg-panel text-agente"]}
            >
              {texto}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
