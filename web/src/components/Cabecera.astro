---
import { REPOSITORIO, versionPublicada } from "../lib/proyecto";
import Icono from "./Icono.astro";
import Logo from "./Logo.astro";

interface Props {
  // Página de la audiencia a la que apuntan los enlaces de sección.
  inicio?: string;
}

const { inicio = "/" } = Astro.props;
const version = versionPublicada();

const secciones = [
  { texto: "Cómo funciona", destino: `${inicio}#diferencia` },
  { texto: "Garantías", destino: `${inicio}#pilares` },
  { texto: "Ejemplos", destino: `${inicio}#casos` },
  { texto: "Instalar", destino: "/instalar/" },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-linea/60 bg-lienzo/90 backdrop-blur-md">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between gap-4 px-4 sm:px-10">
    <div class="flex items-center gap-4">
      <a href="/" aria-label="kitlegal, inicio">
        <Logo />
      </a>
      <a
        href={`${REPOSITORIO}/releases/tag/${version}`}
        class="hidden border-l border-linea pl-3 sm:block"
        title="Última versión publicada"
      >
        <span class="rounded-sm bg-panel-2 px-2 py-0.5 font-mono text-estampa font-semibold text-tinta">{version}</span>
      </a>
    </div>
    <nav aria-label="Secciones" class="hidden items-center gap-8 md:flex">
      {
        secciones.map(({ texto, destino }) => (
          <a href={destino} class="text-sm font-medium text-tenue transition-colors hover:text-tinta">
            {texto}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-4">
      <a
        href={REPOSITORIO}
        class="hidden items-center gap-1.5 text-sm font-medium text-tenue transition-colors hover:text-tinta sm:inline-flex"
      >
        <Icono nombre="code" class="size-[18px]" />
        GitHub
      </a>
      <a
        href="/instalar/"
        class="inline-flex items-center gap-2 rounded-sm bg-noche px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-noche-2"
      >
        <Icono nombre="download" class="size-4 text-sello" />
        Instalar
      </a>
    </div>
  </div>
</header>
