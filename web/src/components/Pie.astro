---
import { audiencias } from "../data/audiencias";
import { CORREO, LICENCIA, REPOSITORIO } from "../lib/proyecto";
import Icono from "./Icono.astro";
import Logo from "./Logo.astro";

const columnas = [
  {
    titulo: "kitlegal",
    enlaces: [
      ...audiencias.map(({ nombre, ruta }) => ({ texto: nombre, destino: ruta })),
      { texto: "Consultas con su cita", destino: "/consultas/" },
      { texto: "Instalar", destino: "/instalar/" },
      { texto: CORREO, destino: `mailto:${CORREO}` },
    ],
  },
  {
    titulo: "Fuentes oficiales",
    enlaces: [
      { texto: "Boletín Oficial del Estado", destino: "https://www.boe.es/" },
      { texto: "Instituto Nacional de Estadística", destino: "https://www.ine.es/" },
    ],
  },
  {
    titulo: "Funciona con",
    enlaces: [
      { texto: "Claude Code", destino: "/instalar/#agentes" },
      { texto: "Codex", destino: "/instalar/#agentes" },
      { texto: "Antigravity", destino: "/instalar/#agentes" },
      { texto: "Estándar Agent Skills", destino: "https://agentskills.io/" },
    ],
  },
  {
    titulo: "Proyecto",
    enlaces: [
      { texto: "Repositorio en GitHub", destino: REPOSITORIO },
      { texto: "Notas de versión", destino: `${REPOSITORIO}/releases` },
      { texto: "Licencia EUPL-1.2", destino: LICENCIA },
      { texto: "Informar de una incidencia", destino: `${REPOSITORIO}/issues` },
      { texto: "El rastreador de kitlegal", destino: "/bot/" },
    ],
  },
];

const anio = new Date().getFullYear();
---

<footer class="border-t border-linea bg-panel/70 py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-10">
    <div class="grid grid-cols-1 gap-12 border-b border-linea pb-14 md:grid-cols-2 lg:grid-cols-6">
      <div class="space-y-4 lg:col-span-2">
        <Logo tamano="pequeno" />
        <p class="max-w-sm text-sm leading-relaxed text-tenue">
          Skills de agente y un programa que dan a tu asistente de IA el texto vigente del BOE y la cita exacta. Software
          libre bajo la Licencia Pública de la Unión Europea (EUPL-1.2).
        </p>
        <p class="text-xs text-tenue">Fuente de los datos citados: Agencia Estatal Boletín Oficial del Estado.</p>
      </div>
      {
        columnas.map(({ titulo, enlaces }) => (
          <div class="space-y-3">
            <h2 class="font-mono text-estampa font-semibold uppercase text-tinta">{titulo}</h2>
            <ul class="space-y-2 text-sm text-tenue">
              {enlaces.map(({ texto, destino }) => (
                <li>
                  <a href={destino} class="transition-colors hover:text-tinta">
                    {texto}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="flex flex-col items-start justify-between gap-4 pt-8 text-xs text-tenue md:flex-row md:items-center">
      <p class="flex items-start gap-2 font-serif text-sm italic">
        <Icono nombre="gavel" class="mt-0.5 size-4 text-sello" />
        kitlegal consulta y cita fuentes oficiales; no presta asesoramiento jurídico ni sustituye a un profesional.
      </p>
      <span class="shrink-0 font-mono">© {anio} kitlegal</span>
    </div>
  </div>
</footer>
