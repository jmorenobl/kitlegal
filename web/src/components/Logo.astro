---
// El logotipo: el icono y la palabra kitlegal, «kit» en noche y «legal» en
// ámbar, en Newsreader. La palabra es texto, no imagen.
interface Props {
  tamano?: "normal" | "pequeno";
}

const { tamano = "normal" } = Astro.props;
---

<span class="inline-flex items-center gap-2.5">
  <img
    src="/favicon.svg"
    alt=""
    width="36"
    height="36"
    class:list={[tamano === "normal" ? "size-9" : "size-8", "rounded-lg"]}
  />
  <span
    class:list={[
      "font-serif font-bold tracking-tight leading-none",
      tamano === "normal" ? "text-[1.75rem]" : "text-2xl",
    ]}
  >
    <span class="text-noche">kit</span><span class="text-sello-tinta">legal</span>
  </span>
</span>
