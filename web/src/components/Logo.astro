---
// El logotipo: el icono y la palabra kitlegal, en Bricolage Grotesque. La
// palabra es texto, no imagen.
interface Props {
  tamano?: "normal" | "pequeno";
}

const { tamano = "normal" } = Astro.props;
const lado = tamano === "normal" ? 32 : 24;
---

<span class:list={["inline-flex items-center font-titular font-bold text-tinta", tamano === "normal" ? "gap-2.5 text-2xl" : "gap-2 text-xl"]}>
  <img src="/favicon.svg" alt="" width={lado} height={lado} />
  <span class="leading-none">kitlegal</span>
</span>
