---
// Ventanilla Legal, el proyecto cívico construido sobre kitlegal: la primera
// fila del pie, para quien llega con un trámite y no es jurista. Va en el pie
// para que el cierre de la portada sea de los despachos.
import Icono from "./Icono.astro";
---

<div
  class="flex flex-col gap-3 border-b border-linea pb-10 mb-12 md:flex-row md:items-center md:justify-between md:gap-8"
>
  <p class="max-w-lectura text-sm leading-relaxed text-tenue">
    <strong class="font-serif text-base font-semibold text-tinta">¿Tienes un trámite y no eres jurista?</strong>{" "}
    Ventanilla Legal es el proyecto cívico construido sobre kitlegal, para personas con un asunto ante una
    administración.
  </p>
  <a
    href="https://ventanillalegal.es"
    class="inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold text-agente underline underline-offset-2 hover:text-tinta"
  >
    Ir a ventanillalegal.es
    <Icono nombre="arrow-forward" class="size-4" />
  </a>
</div>
