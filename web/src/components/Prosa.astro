---
// El marco de las páginas de texto: una cabecera centrada con etiqueta, título
// y entradilla, y el cuerpo en una columna de lectura.
import { chipVigente, pagina } from "../lib/clases";

interface Props {
  etiqueta: string;
  titulo: string;
  entradilla: string;
}

const { etiqueta, titulo, entradilla } = Astro.props;
---

<article>
  <header class:list={[pagina, "flex flex-col items-center gap-[22px] pt-16 text-center"]}>
    <p class={chipVigente}>{etiqueta}</p>
    <h1 class="font-titular text-h1-pagina font-bold text-balance">{titulo}</h1>
    <p class="max-w-[700px] text-entradilla text-pretty text-tenue">{entradilla}</p>
  </header>
  <div
    class="codigo-en-linea mx-auto flex max-w-[880px] flex-col gap-5 px-margen pt-16 text-base leading-[1.6] [&_a]:tocable [&_a]:text-agente [&_h2]:mt-8 [&_h2]:font-titular [&_h2]:text-[26px] [&_h2]:font-bold [&_li]:ml-5 [&_li]:list-disc [&_li]:pl-1 [&_li]:marker:text-agente [&_ul]:flex [&_ul]:flex-col [&_ul]:gap-2"
  >
    <slot />
  </div>
</article>
