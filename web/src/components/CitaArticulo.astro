---
// Un fragmento literal de una norma, con la procedencia que exige el sobre de
// kitlegal: norma, bloque, fecha de consulta y huella, y el enlace al texto
// consolidado en el BOE.
import { articulo, fechaCorta, huellaCorta } from "../lib/citas";

interface Props {
  id: string;
  variante?: "tarjeta" | "destacada";
}

const { id, variante = "tarjeta" } = Astro.props;
const cita = articulo(id);

// Cada fragmento, partido alrededor del destacado si lo contiene (solo la
// primera aparición), con la unión que le corresponde con el anterior.
let resaltado = false;
const partes = cita.fragmentos.map((fragmento, indice) => {
  const union = indice > 0 ? cita.uniones[indice - 1] : undefined;
  const posicion = cita.destacado && !resaltado ? fragmento.indexOf(cita.destacado) : -1;
  if (posicion < 0) return { union, antes: fragmento };
  resaltado = true;
  return {
    union,
    antes: fragmento.slice(0, posicion),
    destacado: cita.destacado,
    despues: fragmento.slice(posicion + cita.destacado!.length),
  };
});
---

<figure class:list={[variante === "tarjeta" && "flex flex-1 flex-col"]}>
  <blockquote
    cite={cita.enlace}
    class:list={[
      "font-serif italic leading-relaxed",
      variante === "destacada" ? "text-base text-tinta" : "mb-6 text-[0.95rem] text-tenue",
    ]}
  >
    <p>
      «{
        partes.map(({ union, antes, destacado, despues }) => (
          <>
            {union === "linea" && <br />}
            {union === "espacio" && " "}
            {union === "elision" && " […] "}
            {antes}
            {destacado && (
              <strong class="font-medium not-italic text-tinta underline decoration-vigente decoration-2 underline-offset-2">
                {destacado}
              </strong>
            )}
            {despues}
          </>
        ))
      }»
    </p>
  </blockquote>
  <figcaption
    class:list={["border-t border-linea/80 pt-3 font-mono text-estampa", variante === "tarjeta" && "mt-auto"]}
  >
    <div class="flex flex-wrap items-center justify-between gap-2">
      <cite class="font-semibold not-italic text-sello-tinta">{cita.referencia}</cite>
      <a
        href={cita.enlace}
        class="rounded-sm bg-panel-2 px-2 py-0.5 text-tenue transition-colors hover:text-tinta"
        title="Texto consolidado en el BOE"
      >
        [{cita.norma}, bloque {cita.bloque}]
      </a>
    </div>
    <p class="mt-2 text-tenue">
      Consultado el {fechaCorta(cita.fechaConsulta)}{
        cita.fechaVersion && <> · versión del {fechaCorta(cita.fechaVersion)}</>
      } · <span title={cita.hash}>{huellaCorta(cita.hash)}</span>
    </p>
  </figcaption>
</figure>
