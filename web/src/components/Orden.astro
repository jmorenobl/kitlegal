---
// Una orden de terminal, en el bloque oscuro de DESIGN.md. Cada línea es un
// bloque, con el indicador en verde, que no se selecciona; un clic en la línea
// la selecciona entera para copiarla.
interface Props {
  lineas: string[];
  indicador?: string;
  etiqueta?: string;
}

const { lineas, indicador = "$", etiqueta } = Astro.props;
---

<figure class="overflow-hidden rounded-[14px] bg-codigo font-mono text-sm leading-6 text-codigo-texto">
  {
    etiqueta && (
      <figcaption class="border-b border-codigo-boton px-[18px] py-2 text-xs text-sobre-oscuro uppercase">
        {etiqueta}
      </figcaption>
    )
  }
  <code class="block overflow-x-auto py-3.5 pr-3.5 pl-[18px] whitespace-pre">
    {
      lineas.map((linea) => (
        <span class="block">
          {indicador && <span class="text-codigo-indicador select-none">{indicador} </span>}
          <span class="select-all">{linea}</span>
        </span>
      ))
    }
  </code>
</figure>
