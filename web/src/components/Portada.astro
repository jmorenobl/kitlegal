---
// La portada de una audiencia: las secciones de la maqueta de Stitch con los
// datos de audiencias.ts, las citas de citas.yaml y las cifras de data/.
import { type Audiencia, type Tono } from "../data/audiencias";
import { rutaDeConsulta } from "../data/consultas";
import { articulo, fechaCorta, huellaCorta, norma } from "../lib/citas";
import { CORREO } from "../lib/proyecto";
import CitaArticulo from "./CitaArticulo.astro";
import Icono from "./Icono.astro";
import ComparativaMercado from "./ComparativaMercado.astro";

interface Props {
  audiencia: Audiencia;
}

const { audiencia } = Astro.props;
const { comparativa, garantias, contacto } = audiencia;
const derogada = norma("ley-30-1992", "derogada");
const avisoDerogada = derogada.avisos.find((aviso) => aviso.codigo === "derogada")!;
const citaDestacada = articulo(comparativa.cita);

const tinta: Record<Tono, string> = {
  sello: "text-sello-tinta",
  derogada: "text-derogada-tinta",
  agente: "text-agente",
  vigente: "text-vigente-tinta",
};
const icono: Record<Tono, string> = {
  sello: "text-sello",
  derogada: "text-derogada",
  agente: "text-agente",
  vigente: "text-vigente",
};

// Lo que ocurre entre la pregunta y la respuesta, en orden: al lado del
// titular, antes del díptico, que lo enseña con un caso.
const pasos = [
  "Preguntas con tus palabras",
  "Tu asistente llama a kitlegal",
  "kitlegal lee la norma en el BOE",
  "Comprueba su vigencia",
  "Recibes la respuesta con su cita",
];

// La respuesta de memoria, partida alrededor de las marcas del error.
const expresion = new RegExp(`(${comparativa.marcas.map((m) => m.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|")})`);
const respuesta = comparativa.respuesta.split(expresion).map((trozo) => ({
  texto: trozo,
  marcado: comparativa.marcas.includes(trozo),
}));
---

<section class="relative overflow-hidden bg-gradient-to-b from-lienzo via-lienzo to-panel/40 pt-20 pb-16 md:pt-28 md:pb-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-10">
    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_17rem] lg:items-end lg:gap-16 xl:gap-24">
    <div>
    <h1 class="text-balance mb-8 max-w-4xl font-serif text-titular font-semibold text-tinta lg:text-display">
      {audiencia.h1}
    </h1>
    <p class="mb-10 max-w-lectura text-lg leading-relaxed text-tenue">{audiencia.subtitulo}</p>

    <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
      <a href={audiencia.secundario.destino} class="inline-flex w-full items-center justify-center gap-2 rounded-sm bg-noche px-7 py-3.5 text-sm font-semibold text-white shadow-md transition-colors hover:bg-noche-2 sm:w-auto">
        <Icono nombre={audiencia.secundario.icono} class="size-[18px] text-sello" />
        {audiencia.secundario.texto}
      </a>
      <a
        href="#diferencia"
        class="inline-flex items-center justify-center gap-1.5 text-sm font-semibold text-agente underline underline-offset-2 hover:text-tinta"
      >
        Ver cómo funciona
        <Icono nombre="arrow-downward" class="size-4" />
      </a>
    </div>
    </div>
    <div class="mt-14 lg:mt-0">
      <p id="titulo-pasos" class="mb-3 font-serif text-lg font-semibold text-tinta">
        Entre la pregunta y la respuesta
      </p>
      <ol aria-labelledby="titulo-pasos" class="border-l border-linea-2 text-sm">
        {
          pasos.map((paso, indice) => (
            <li class="relative flex items-baseline gap-3 py-2 pl-5">
              <span class="font-mono text-estampa font-semibold text-sello-tinta">{indice + 1}</span>
              <span class:list={[indice === pasos.length - 1 ? "font-semibold text-tinta" : "text-tenue"]}>{paso}</span>
            </li>
          ))
        }
      </ol>
    </div>
    </div>

    <figure id="diferencia" aria-label="Cómo funciona: la misma consulta, de memoria y con kitlegal" class="mt-16">
      <figcaption class="mb-6">
        <span class="mb-3 block text-sm font-medium text-tenue">
          La misma consulta, dos respuestas: de memoria y con kitlegal.
        </span>
        <span class="block rounded-md border border-linea bg-white px-5 py-4 font-mono text-sm text-tinta">
          <span class="font-sans font-semibold">Consulta:</span>{" "}
          {comparativa.consulta}
        </span>
      </figcaption>
      <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-2">
        <article
          aria-labelledby="titulo-sin"
          class="flex flex-col rounded-lg border border-derogada-borde/70 bg-white p-6 shadow-[0_2px_12px_rgba(239,68,68,0.05)] sm:p-8"
        >
          <div class="space-y-6">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-linea pb-4">
              <h2 id="titulo-sin" class="flex items-center gap-2 text-sm font-semibold text-derogada-tinta">
                <Icono nombre="cancel" class="size-5 text-derogada" />
                Asistente de IA sin kitlegal
              </h2>
              <span
                class="rounded-sm border border-derogada-borde bg-derogada-fondo px-2.5 py-1 font-mono text-estampa font-bold text-derogada-tinta uppercase"
              >
                {comparativa.insignia}
              </span>
            </div>
            <p class="leading-relaxed text-tinta italic">
              <span class="sr-only">Respuesta de ejemplo, sin fuente: </span>
              {
                respuesta.map(({ texto, marcado }) =>
                  marcado ? (
                    <mark class="rounded-sm bg-derogada-fondo px-1 font-semibold text-derogada-tinta not-italic">
                      {texto}
                    </mark>
                  ) : (
                    texto
                  ),
                )
              }
            </p>
            <div class="space-y-1.5 rounded-md bg-derogada-fondo/80 p-4 text-xs text-derogada-tinta">
              <p class="flex items-center gap-1.5 text-sm font-bold">
                <Icono nombre="error" class="size-[18px] text-derogada" />
                {comparativa.alertaTitulo}
              </p>
              <p class="leading-relaxed">{comparativa.alertaTexto}</p>
            </div>
          </div>
          <div class="mt-6 flex flex-wrap items-center justify-between gap-2 border-t border-linea pt-6 font-mono text-estampa">
            <span class="flex items-center gap-1.5 font-medium text-derogada-tinta">
              <span class="size-1.5 rounded-full bg-derogada"></span>
              Respuesta de memoria
            </span>
            <span class="font-semibold text-derogada-tinta uppercase">{comparativa.pieMalo}</span>
          </div>
        </article>

        <article
          aria-labelledby="titulo-con"
          class="flex flex-col rounded-lg border-2 border-vigente/40 bg-white p-6 shadow-[0_4px_20px_rgba(16,185,129,0.08)] sm:p-8"
        >
          <div class="space-y-6">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-linea pb-4">
              <h2 id="titulo-con" class="flex items-center gap-2 text-sm font-semibold text-vigente-tinta">
                <Icono nombre="verified" class="size-5 text-vigente" />
                Tu asistente con kitlegal
              </h2>
              <span
                class="rounded-sm border border-vigente-borde bg-vigente-fondo px-2.5 py-1 font-mono text-estampa font-bold text-vigente-tinta uppercase"
              >
                Cita del BOE
              </span>
            </div>
            <div role="note" class="rounded-md border border-linea bg-panel/40 p-3 text-xs">
              <p class="mb-2 flex items-center gap-1.5 font-semibold text-tinta">
                <Icono nombre="verified" class="size-4 text-vigente" />
                Detectado antes de citar
              </p>
              <p class="font-mono leading-relaxed">
                <span class="rounded-sm border border-derogada-borde bg-derogada-fondo px-1.5 py-0.5 font-semibold text-derogada-tinta">
                  {avisoDerogada.texto}
                </span>{" "}
                <a href={derogada.enlace} class="text-tenue underline decoration-linea-2 underline-offset-2 hover:text-tinta">
                  {derogada.referencia} [{derogada.norma}]
                </a>
              </p>
              <p class="mt-1.5 font-mono text-tenue">
                Metadatos del BOE · {fechaCorta(derogada.fechaConsulta)} · {huellaCorta(derogada.hash)}
              </p>
            </div>
            <div class="border-t border-linea pt-6">
              <CitaArticulo id={comparativa.cita} variante="destacada" />
              <p class="mt-4 text-xs leading-relaxed text-tenue">
                Cómo se lee la cita: <span class="font-mono text-tinta">{citaDestacada.norma}</span> es el identificador
                de la norma en el BOE, y el bloque <span class="font-mono text-tinta">{citaDestacada.bloque}</span>, la
                parte del texto consolidado que contiene el artículo. La huella del texto (<span class="font-mono text-tinta">sha256</span>)
                se calcula sobre lo leído: si el BOE cambia el artículo, la huella cambia y se nota.
              </p>
            </div>
          </div>
          <div class="mt-6 flex flex-wrap items-center justify-between gap-2 border-t border-linea pt-6 font-mono text-estampa">
            <span class="flex items-center gap-1.5 font-medium text-vigente-tinta">
              <span class="size-1.5 rounded-full bg-vigente"></span>
              Texto consolidado del BOE
            </span>
            <span class="font-semibold text-agente">Con fuente verificable</span>
          </div>
        </article>
      </div>
    </figure>

    <div class="mt-12 grid grid-cols-1 gap-4 border-t border-linea pt-8 text-sm md:grid-cols-2">
      <p class="flex items-start gap-3 text-tenue">
        <Icono nombre="download" class="mt-0.5 size-5 text-sello" />
        <span>
          Se instala una vez en la app de escritorio de Claude, sin terminal. En ChatGPT, Codex y Antigravity, sin
          probar.{" "}
          <a href="/instalar/" class="font-semibold text-agente underline underline-offset-2">Ver la guía paso a paso</a>
        </span>
      </p>
      <p class="flex items-start gap-3 text-tenue">
        <Icono nombre="mail" class="mt-0.5 size-5 text-sello" />
        <span>
          ¿Qué le falta para tu despacho? Escríbenos a{" "}
          <a href={`mailto:${CORREO}`} class="font-semibold text-agente underline underline-offset-2">{CORREO}</a>.
        </span>
      </p>
    </div>
  </div>
</section>

<ComparativaMercado>
  <div
    id="pilares"
    class="mt-8 rounded-lg border border-linea bg-panel/40 p-5 sm:p-6"
  >
    {
      garantias.sentencias && (
        <p class="mb-5 flex items-start gap-3 border-b border-linea pb-5">
          <Icono nombre="gavel" class="mt-1 size-6 text-agente" />
          <span>
            <strong class="block font-serif text-xl font-semibold text-tinta">{garantias.sentencias.titulo}.</strong>
            <span class="mt-1 block max-w-lectura leading-relaxed text-tenue">{garantias.sentencias.texto}</span>
          </span>
        </p>
      )
    }
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between md:gap-10">
    <p class="max-w-lectura text-sm leading-relaxed text-tenue">
      <strong class="font-serif text-base font-semibold text-tinta">{garantias.titulo}.</strong>{" "}
      {garantias.texto}
    </p>
    {
      garantias.enlace && (
        <a
          href={garantias.enlace.destino}
          class="inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold text-agente underline underline-offset-2 hover:text-tinta"
        >
          {garantias.enlace.texto}
          <Icono nombre="arrow-forward" class="size-4" />
        </a>
      )
    }
    </div>
  </div>
</ComparativaMercado>

<section id="casos" aria-labelledby="titulo-casos" class="border-t border-linea bg-panel/40 py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-10">
    <div class="mb-16 flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <h2 id="titulo-casos" class="text-balance font-serif text-3xl font-semibold text-tinta md:text-4xl">
          Consultas habituales, con su cita
        </h2>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-tenue">
        Cuatro preguntas y el fragmento literal del BOE que las responde, con la norma y el bloque del que sale, tal
        como lo devuelve kitlegal.
      </p>
    </div>
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      {
        audiencia.casos.map(({ icono: nombre, tono, etiqueta, pregunta, cita, consulta }) => (
          <article class="flex flex-col rounded-lg border border-linea bg-white p-6 shadow-xs transition-shadow hover:shadow-md sm:p-8">
            <div>
              <p class="mb-3 flex items-center gap-2">
                <Icono nombre={nombre} class:list={["size-[18px]", icono[tono]]} />
                <span class:list={["font-mono text-estampa font-bold uppercase", tinta[tono]]}>{etiqueta}</span>
              </p>
              <h3 class="mb-3 font-serif text-lg font-semibold text-tinta">{pregunta}</h3>
            </div>
            <CitaArticulo id={cita} />
            {consulta ? (
              <a
                href={rutaDeConsulta(consulta)}
                class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-agente underline-offset-2 hover:underline"
              >
                Ver la respuesta, punto por punto
                <Icono nombre="arrow-forward" class="size-4" />
              </a>
            ) : (
              <a
                href={articulo(cita).enlace}
                class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-tenue underline decoration-linea-2 underline-offset-2 hover:text-tinta"
              >
                Leer el artículo en boe.es
                <Icono nombre="open-in-new" class="size-4" />
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<section id="integracion" aria-labelledby="titulo-integracion" class="border-t border-linea bg-lienzo py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-10">
    <div class="mx-auto mb-20 max-w-2xl text-center">
      <h2 id="titulo-integracion" class="text-balance mb-4 font-serif text-3xl font-semibold text-tinta md:text-4xl">
        Se instala una vez y se usa preguntando
      </h2>
      <p class="mx-auto max-w-lectura leading-relaxed text-tenue">
        Hace falta un asistente de IA que trabaje en tu ordenador: hoy, la app de escritorio de Claude o Claude Code.
        Con la app abierta en tu ordenador, también puedes preguntar desde Claude en el móvil o en la web. En ChatGPT,
        Codex y Antigravity está <a href="/instalar/#sin-probar" class="text-agente underline underline-offset-2">sin probar</a>.
      </p>
    </div>
    <ol class="mx-auto mb-14 grid max-w-5xl grid-cols-1 items-stretch gap-8 md:grid-cols-2">
      <li class="flex flex-col justify-between rounded-lg border border-linea bg-white p-8 shadow-sm">
        <div>
          <div class="mb-6 flex items-center justify-between">
            <span class="flex size-9 items-center justify-center rounded-lg bg-noche font-mono text-sm font-bold text-white">
              1
            </span>
            <span class="font-mono text-xs font-semibold text-tenue uppercase">Una sola vez</span>
          </div>
          <h3 class="mb-3 font-serif text-xl font-semibold text-tinta">Instalas kitlegal</h3>
          <p class="mb-6 text-sm leading-relaxed text-tenue">
            Es un plugin, una extensión que se añade desde la propia app, sin terminal: trae las herramientas que leen el BOE y las instrucciones
            con las que tu asistente lo cita. No hace falta saber programar, y la guía lo explica paso a paso.
          </p>
        </div>
        <a
          href="/instalar/"
          class="inline-flex items-center justify-center gap-2 rounded-sm bg-noche px-4 py-3 text-sm font-semibold text-white hover:bg-noche-2"
        >
          <Icono nombre="download" class="size-4 text-sello" />
          Ver la guía de instalación
        </a>
      </li>
      <li class="flex flex-col justify-between rounded-lg border border-linea bg-white p-8 shadow-sm">
        <div>
          <div class="mb-6 flex items-center justify-between">
            <span class="flex size-9 items-center justify-center rounded-lg bg-noche font-mono text-sm font-bold text-white">
              2
            </span>
            <span class="font-mono text-xs font-semibold text-tenue uppercase">En tu día a día</span>
          </div>
          <h3 class="mb-3 font-serif text-xl font-semibold text-tinta">Preguntas con tus palabras</h3>
          <p class="mb-6 text-sm leading-relaxed text-tenue">
            Escribes en tu asistente como siempre. Él consulta kitlegal, lee el BOE y te responde con la cita: la norma,
            el artículo y la fecha de consulta.
          </p>
        </div>
        <p class="rounded-sm border border-linea bg-panel p-3 text-xs text-tinta italic">
          «¿Cuál es el plazo para interponer un recurso de alzada según la ley vigente?»
        </p>
      </li>
    </ol>
  </div>
</section>

{
  contacto && (
    <section id="contacto" aria-labelledby="titulo-contacto" class="border-t border-linea bg-panel/40 py-24 md:py-32">
      <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-4 sm:px-10 lg:grid-cols-2 lg:gap-16">
        <div>
          <h2 id="titulo-contacto" class="text-balance mb-4 font-serif text-3xl font-semibold text-tinta md:text-4xl">
            {contacto.titulo}
          </h2>
          <p class="mb-8 max-w-lectura leading-relaxed text-tenue">{contacto.texto}</p>
          <a
            href={`mailto:${CORREO}?subject=${encodeURIComponent(contacto.asunto)}`}
            class="inline-flex items-center justify-center gap-2 rounded-sm bg-noche px-7 py-3.5 text-sm font-semibold text-white shadow-md transition-colors hover:bg-noche-2"
          >
            <Icono nombre="mail" class="size-[18px] text-sello" />
            {CORREO}
          </a>
        </div>
        <div class="rounded-lg border border-linea bg-white p-6 shadow-sm sm:p-8">
          <h3 class="mb-4 font-serif text-xl font-semibold text-tinta">Lo que más nos ayuda saber</h3>
          <ul class="mb-6 space-y-3 text-sm leading-relaxed text-tenue">
            {contacto.peticiones.map((peticion) => (
              <li class="flex items-start gap-2.5">
                <Icono nombre="chat" class="mt-0.5 size-[18px] text-sello" />
                <span>{peticion}</span>
              </li>
            ))}
          </ul>
          <h3 class="mb-1 border-t border-linea pt-5 font-serif text-lg font-semibold text-tinta">Todavía no lo hace</h3>
          <p class="mb-3 text-sm text-tenue">Estamos trabajando en ello:</p>
          <ul class="mb-6 space-y-2.5 text-sm leading-relaxed text-tenue">
            {contacto.enMarcha.map((frase) => (
              <li class="flex items-start gap-2.5">
                <Icono nombre="pending" class="mt-0.5 size-[18px] text-sello" />
                <span>{frase}</span>
              </li>
            ))}
          </ul>
          <h3 class="mb-3 font-serif text-lg font-semibold text-tinta">Lo que no hará</h3>
          <div class="mb-6 flex items-start gap-2.5 text-sm leading-relaxed text-tenue">
            <Icono nombre="block" class="mt-0.5 size-[18px] text-tinta" />
            <details class="group">
              <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                {contacto.descartado.resumen}{" "}
                <span class="font-semibold text-tinta underline underline-offset-2 group-open:hidden">Por qué</span>
              </summary>
              <p class="mt-1">
                {contacto.descartado.explicacion}{" "}
                <a href={contacto.detalle.destino} class="font-semibold text-tinta underline underline-offset-2">
                  {contacto.detalle.texto}
                </a>
              </p>
            </details>
          </div>
          <p class="text-xs leading-relaxed text-tenue">{contacto.aviso}</p>
        </div>
      </div>
    </section>
  )
}

<section aria-labelledby="titulo-cta" class="border-t border-linea bg-lienzo py-24 md:py-32">
  <div class="mx-auto max-w-4xl px-4 text-center sm:px-10">
    <h2 id="titulo-cta" class="text-balance mb-6 font-serif text-3xl leading-tight font-semibold text-tinta md:text-5xl">{audiencia.cta.titulo}</h2>
    <p class="mx-auto mb-10 max-w-2xl text-lg leading-relaxed text-tenue">{audiencia.cta.texto}</p>
    <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href="/instalar/"
        class="inline-flex w-full items-center justify-center gap-2 rounded-sm bg-noche px-7 py-3.5 text-sm font-semibold text-white shadow-md transition-colors hover:bg-noche-2 sm:w-auto"
      >
        <Icono nombre="download" class="size-[18px] text-sello" />
        Instalar kitlegal, paso a paso
      </a>
      <a
        href="/como-se-evalua/"
        class="inline-flex w-full items-center justify-center gap-2 rounded-sm border border-linea bg-white px-7 py-3.5 text-sm font-semibold text-tinta shadow-sm transition-colors hover:border-linea-2 hover:bg-papel sm:w-auto"
      >
        <Icono nombre="fact-check" class="size-[18px] text-tenue" />
        Ver cómo se comprueba
      </a>
    </div>
  </div>
</section>

