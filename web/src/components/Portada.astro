---
// La portada de una audiencia: los datos de audiencias.ts, las citas de
// citas.yaml y las cifras de data/.
//
// La caja de preguntas cambia de tema sin JavaScript, que la página no admite
// (ADR 0024): cada tema es un botón de opción, los cuatro paneles salen ya en
// el HTML y el CSS enseña el del botón marcado.
import { type Audiencia, audiencias, ciudadania } from "../data/audiencias";
import { rutaDeConsulta } from "../data/consultas";
import {
  boton,
  chipPequeno,
  chipVigente,
  etiquetaMayusculas,
  etiquetaSeccion,
  pagina,
  punto,
  titularSeccion,
} from "../lib/clases";
import { fechaCorta, huellaCorta, norma } from "../lib/citas";
import { CORREO, REPOSITORIO } from "../lib/proyecto";
import CitaArticulo from "./CitaArticulo.astro";

interface Props {
  audiencia: Audiencia;
}

const { audiencia } = Astro.props;
const { comparativa, garantias, contacto } = audiencia;
const derogada = norma("ley-30-1992", "derogada");
const avisoDerogada = derogada.avisos.find((aviso) => aviso.codigo === "derogada")!;
const esPortada = audiencia === ciudadania;

// El panel de cada tema se ve cuando su botón está marcado. Las clases van
// escritas enteras para que Tailwind las encuentre.
const visible = [
  "group-has-[#tema-0:checked]/caja:block",
  "group-has-[#tema-1:checked]/caja:block",
  "group-has-[#tema-2:checked]/caja:block",
  "group-has-[#tema-3:checked]/caja:block",
];

// Lo que ocurre entre la pregunta y la respuesta, en orden.
const pasos = [
  "Preguntas con tus palabras",
  "Tu asistente llama a kitlegal",
  "kitlegal lee la norma en el BOE",
  "Comprueba si sigue en vigor",
  "Recibes la respuesta con su cita",
];

// La respuesta de memoria, partida alrededor de las marcas del error.
const expresion = new RegExp(`(${comparativa.marcas.map((m) => m.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|")})`);
const respuesta = comparativa.respuesta.split(expresion).map((trozo) => ({
  texto: trozo,
  marcado: comparativa.marcas.includes(trozo),
}));

const [primario, secundario] = audiencia.botones;
---

<section class:list={[pagina, "flex flex-col items-center gap-6 pt-16 text-center"]}>
  {
    !esPortada && (
      <nav aria-label="Audiencia">
        <ul class="flex flex-wrap justify-center gap-1 rounded-3xl border border-linea bg-white p-1 text-sm font-semibold">
          {audiencias.map(({ ruta, nombre }) => {
            const actual = ruta === audiencia.ruta;
            return (
              <li class="flex">
                <a
                  href={ruta}
                  aria-current={actual ? "page" : undefined}
                  class:list={["tocable rounded-full px-3.5 py-[7px]", actual ? "bg-tinta text-white" : "text-tenue"]}
                >
                  {nombre}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    )
  }
  <p class={chipVigente}>{audiencia.insignia}</p>
  <h1
    class:list={[
      "font-titular font-bold text-balance",
      esPortada ? "max-w-[1040px] text-h1" : "max-w-[1060px] text-h1-pagina",
    ]}
  >
    {audiencia.h1}
  </h1>
  <p class="max-w-[760px] text-entradilla text-pretty text-tenue">{audiencia.subtitulo}</p>
</section>

<section
  id="casos"
  aria-label="Preguntas de ejemplo, con su cita"
  class="group/caja mx-auto mt-12 flex w-full max-w-[960px] flex-col gap-4 px-margen"
>
  <fieldset class="flex flex-wrap justify-center gap-2">
    <legend class="sr-only">Elige un tema</legend>
    {
      audiencia.casos.map(({ etiqueta }, indice) => (
        <label class="tocable cursor-pointer rounded-full border border-linea-2 bg-white px-[18px] py-2.5 text-[15px] font-semibold has-checked:border-tinta has-checked:bg-tinta has-checked:text-white has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-agente">
          <input type="radio" name="tema" id={`tema-${indice}`} checked={indice === 0} class="sr-only" />
          {etiqueta}
        </label>
      ))
    }
  </fieldset>
  {
    audiencia.casos.map(({ pregunta, cita, consulta }, indice) => (
      <article
        class:list={[
          "hidden overflow-hidden rounded-3xl border border-linea bg-white text-left shadow-destacada",
          visible[indice],
        ]}
      >
        <div class="flex items-center gap-3.5 border-b border-linea-suave px-7 py-[22px] max-sm:px-5">
          <span
            aria-hidden="true"
            class="grid size-9 flex-none place-items-center rounded-full bg-panel font-bold text-agente"
          >
            ?
          </span>
          <h2 class="text-xl font-semibold">{pregunta}</h2>
        </div>
        <div class="flex flex-col gap-4 p-7 max-sm:p-5">
          <span class:list={[chipPequeno, "bg-vigente-fondo text-vigente-tinta"]}>Texto literal del BOE</span>
          <CitaArticulo id={cita} variante="pregunta" />
          {consulta && (
            <a href={rutaDeConsulta(consulta)} class="tocable self-start text-[15px] font-semibold text-agente">
              Ver la respuesta, punto por punto →
            </a>
          )}
        </div>
      </article>
    ))
  }
  <div class="flex flex-wrap justify-center gap-3 pt-4">
    <a href={primario.destino} class={boton.primario}>{primario.texto}</a>
    <a href={secundario.destino} class={boton.secundario}>{secundario.texto}</a>
  </div>
</section>

<section
  id="pilares"
  aria-label="Lo que te garantiza"
  class:list={[pagina, "grid grid-cols-[repeat(auto-fit,minmax(min(240px,100%),1fr))] gap-4 pt-seccion-1"]}
>
  {
    audiencia.metricas.map(({ etiqueta, valor, texto, punto: color }) => (
      <div class="flex flex-col gap-2.5 rounded-[20px] border border-linea bg-white p-[26px]">
        <span aria-hidden="true" class:list={["size-2.5 rounded-full", punto[color]]} />
        <p class={etiquetaMayusculas}>{etiqueta}</p>
        <p class="font-titular text-2xl leading-[1.1] font-bold">{valor}</p>
        <p class="text-[15px] leading-[1.55] text-tenue">{texto}</p>
      </div>
    ))
  }
</section>

<section id="diferencia" aria-labelledby="titulo-diferencia" class:list={[pagina, "flex flex-col gap-10 pt-seccion"]}>
  <div class="flex flex-col items-center gap-3.5 text-center">
    <p class={etiquetaSeccion}>Contraste de rigor</p>
    <h2 id="titulo-diferencia" class:list={[titularSeccion, "max-w-[860px]"]}>
      La diferencia entre responder de memoria y responder con la cita
    </h2>
    <p class="max-w-[760px] text-lg leading-[1.6] text-tenue">
      Un modelo generalista responde con lo que recuerda y no sabe qué normas siguen en vigor. Con kitlegal, tu
      asistente lee el texto consolidado del BOE antes de responder y te dice de dónde sale cada frase.
    </p>
  </div>

  <ol aria-label="Cómo funciona, paso a paso" class="flex flex-wrap justify-center gap-2.5">
    {
      pasos.map((texto, indice) => (
        <li class="flex items-center gap-2.5 rounded-full border border-linea bg-white py-2 pr-4 pl-2 text-[15px] font-medium">
          <span
            aria-hidden="true"
            class="grid size-7 flex-none place-items-center rounded-full bg-tinta text-[13px] font-bold text-white"
          >
            {indice + 1}
          </span>
          {texto}
        </li>
      ))
    }
  </ol>

  <p class="text-center text-[17px] text-tenue">
    <b class="text-tinta">Consulta:</b>{" "}
    {comparativa.consulta}
  </p>

  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(380px,100%),1fr))] gap-5">
    <article
      aria-labelledby="titulo-sin"
      class="flex flex-col gap-4 rounded-3xl border border-derogada-borde bg-derogada-fondo p-tarjeta"
    >
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h3 id="titulo-sin" class="text-[19px] font-bold">Asistente de IA sin kitlegal</h3>
        <span class:list={[chipPequeno, "bg-white text-derogada-tinta"]}>{comparativa.insignia}</span>
      </div>
      <p class="text-[21px] leading-[1.5]">
        <span class="sr-only">Respuesta de ejemplo, sin fuente: </span>
        {
          respuesta.map(({ texto, marcado }) =>
            marcado ? (
              <mark class="bg-derogada-borde font-semibold text-derogada-tinta">{texto}</mark>
            ) : (
              texto
            ),
          )
        }
      </p>
      <div class="mt-auto flex flex-col gap-1 rounded-[14px] bg-white px-[18px] py-4">
        <b class="text-derogada-tinta">{comparativa.alertaTitulo}</b>
        <p class="text-[15px] leading-[1.55] text-tenue">{comparativa.alertaTexto}</p>
      </div>
    </article>

    <article
      aria-labelledby="titulo-con"
      class="flex flex-col gap-4 rounded-3xl border border-vigente-borde bg-vigente-fondo p-tarjeta"
    >
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h3 id="titulo-con" class="text-[19px] font-bold">Tu asistente con kitlegal</h3>
        <span class:list={[chipPequeno, "bg-white text-vigente-tinta"]}>Cita del BOE</span>
      </div>
      <p role="note" class="text-[13px] leading-[1.6] text-derogada-tinta">
        <strong class="font-semibold">{avisoDerogada.texto}</strong>{" "}
        <a href={derogada.enlace} class="tocable font-mono underline decoration-derogada-borde underline-offset-2">
          {derogada.referencia} [{derogada.norma}]
        </a>
        <span class="block font-mono text-tenue">
          kitlegal boe metadatos · {fechaCorta(derogada.fechaConsulta)} · {huellaCorta(derogada.hash)}
        </span>
      </p>
      <CitaArticulo id={comparativa.cita} variante="comparativa" />
    </article>
  </div>
</section>

<section
  aria-labelledby="titulo-garantias"
  class:list={[pagina, "grid grid-cols-[repeat(auto-fit,minmax(min(300px,100%),1fr))] gap-4 pt-seccion"]}
>
  <div class="col-span-full mb-6 flex flex-col gap-3.5">
    <p class={etiquetaSeccion}>{garantias.antetitulo}</p>
    <h2 id="titulo-garantias" class:list={[titularSeccion, "max-w-[820px]"]}>{garantias.titulo}</h2>
    <p class="max-w-[820px] text-lg leading-[1.6] text-tenue">{garantias.texto}</p>
  </div>
  {
    garantias.pilares.map(({ titulo, texto, pie }, indice) => (
      <div class="flex flex-col gap-3 rounded-3xl bg-tinta p-tarjeta text-white">
        <span aria-hidden="true" class="font-titular text-[40px] font-bold text-acento-oscuro">
          {String(indice + 1).padStart(2, "0")}
        </span>
        <h3 class="text-[22px] font-bold">{titulo}</h3>
        <p class="text-[15px] leading-[1.6] text-sobre-oscuro">{texto}</p>
        <p class="mt-auto text-[13px] font-semibold text-codigo-indicador">{pie}</p>
      </div>
    ))
  }
</section>

<section
  id="integracion"
  aria-labelledby="titulo-integracion"
  class:list={[pagina, "grid grid-cols-[repeat(auto-fit,minmax(min(380px,100%),1fr))] gap-5 pt-seccion"]}
>
  <div class="col-span-full mb-6 flex flex-col items-center gap-3.5 text-center">
    <p class={etiquetaSeccion}>Qué necesitas</p>
    <h2 id="titulo-integracion" class={titularSeccion}>Se instala una vez y se usa preguntando</h2>
    <p class="max-w-[760px] text-lg leading-[1.6] text-tenue">
      Hace falta un asistente de IA que trabaje en tu ordenador: hoy, la app de escritorio de Claude o Claude Code. En
      la web y en el móvil (ChatGPT, el chat de Claude, Gemini) todavía no funciona.
    </p>
  </div>
  <div class="flex flex-col gap-3 rounded-3xl border border-linea bg-white p-tarjeta-amplia">
    <span
      aria-hidden="true"
      class="grid size-12 place-items-center rounded-full bg-agente font-titular text-[22px] font-bold text-white"
    >
      1
    </span>
    <p class={etiquetaMayusculas}>Una sola vez</p>
    <h3 class="font-titular text-[28px] leading-[1.1] font-bold">Instalas kitlegal</h3>
    <p class="text-base leading-[1.6] text-tenue">
      Son dos descargas que se abren en la app de escritorio de Claude, sin terminal: la extensión, que lee el BOE, y
      el plugin, que enseña a Claude a citarlo. No hace falta saber programar, y la guía lo explica paso a paso.
    </p>
    <a href="/instalar/" class:list={[boton.pequeno, "mt-2 self-start"]}>Ver la guía de instalación</a>
  </div>
  <div class="flex flex-col gap-3 rounded-3xl border border-linea bg-white p-tarjeta-amplia">
    <span
      aria-hidden="true"
      class="grid size-12 place-items-center rounded-full bg-vigente font-titular text-[22px] font-bold text-white"
    >
      2
    </span>
    <p class={etiquetaMayusculas}>En tu día a día</p>
    <h3 class="font-titular text-[28px] leading-[1.1] font-bold">Preguntas con tus palabras</h3>
    <p class="text-base leading-[1.6] text-tenue">
      Escribes en tu asistente como siempre. Él consulta kitlegal, lee el BOE y te responde con la cita: la norma, el
      artículo y la fecha de consulta.
    </p>
    <p class="mt-2 rounded-2xl bg-panel px-[18px] py-3.5 text-base font-medium">
      «¿Cuál es el plazo para interponer un recurso de alzada según la ley vigente?»
    </p>
  </div>
</section>

{
  contacto && (
    <section id="contacto" aria-labelledby="titulo-contacto" class:list={[pagina, "flex flex-col gap-8 pt-seccion"]}>
      <div class="flex flex-col items-center gap-3.5 text-center">
        <p class={etiquetaSeccion}>{contacto.antetitulo}</p>
        <h2 id="titulo-contacto" class={titularSeccion}>
          {contacto.titulo}
        </h2>
        <p class="max-w-[780px] text-lg leading-[1.6] text-tenue">{contacto.texto}</p>
        <a href={`mailto:${CORREO}?subject=${encodeURIComponent(contacto.asunto)}`} class:list={[boton.oscuro, "mt-2"]}>
          {CORREO}
        </a>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(380px,100%),1fr))] gap-5">
        <div class="flex flex-col gap-4 rounded-3xl border border-linea bg-white p-tarjeta">
          <h3 class="text-[22px] font-bold">Lo que más nos ayuda saber</h3>
          <ul class="flex flex-col gap-4">
            {contacto.peticiones.map((peticion) => (
              <li class="flex gap-3 text-base leading-[1.55]">
                <span aria-hidden="true" class="mt-2 size-2 flex-none rounded-full bg-vigente" />
                <span>{peticion}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="flex flex-col gap-4 rounded-3xl border border-linea bg-white p-tarjeta">
          <h3 class="text-[22px] font-bold">Lo que hoy no hace</h3>
          <ul class="flex flex-col gap-4">
            {contacto.todavia.map((frase) => (
              <li class="flex gap-3 text-base leading-[1.55] text-tenue">
                <span aria-hidden="true" class="mt-2 size-2 flex-none rounded-full bg-sello" />
                <span>{frase}</span>
              </li>
            ))}
          </ul>
          <a href={contacto.detalle.destino} class="tocable text-[15px] font-semibold text-agente">
            {contacto.detalle.texto} →
          </a>
        </div>
      </div>
      <p class="text-center text-sm text-tenue">{contacto.aviso}</p>
    </section>
  )
}

<div class={pagina}>
  <section
    aria-labelledby="titulo-cta"
    class="mt-seccion flex flex-col items-center gap-5 rounded-[32px] bg-agente px-[clamp(22px,5vw,72px)] py-[clamp(40px,6vw,72px)] text-center text-white"
  >
    <h2 id="titulo-cta" class="max-w-[820px] font-titular text-h2-cta font-bold text-balance">{audiencia.cta.titulo}</h2>
    <p class="max-w-[640px] text-lg leading-[1.6]">{audiencia.cta.texto}</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/instalar/" class={boton.claro}>Instalar kitlegal, paso a paso</a>
      <a href={`${REPOSITORIO}#readme`} class={boton.contorno}>Leer la documentación</a>
    </div>
    <p class="text-sm">
      Funciona en la app de escritorio de Claude y en Claude Code · kitlegal no envía tus consultas a ningún servidor
      propio
    </p>
  </section>
</div>
