---
// La portada de una audiencia: las secciones de la maqueta de Stitch con los
// datos de audiencias.ts, las citas de citas.yaml y las cifras de data/.
import { type Audiencia } from "../data/audiencias";
import { rutaDeConsulta } from "../data/consultas";
import { articulo, fechaCorta, huellaCorta, norma } from "../lib/citas";
import { getImage } from "astro:assets";
import { ilustracion } from "../lib/ilustraciones";
import { CORREO, enlaceCorreo } from "../lib/proyecto";
import CitaArticulo from "./CitaArticulo.astro";
import Icono from "./Icono.astro";
import ComparativaMercado from "./ComparativaMercado.astro";

interface Props {
  audiencia: Audiencia;
}

const { audiencia } = Astro.props;
const { comparativa, garantias, contacto } = audiencia;
const derogada = norma("ley-30-1992", "derogada");
const avisoDerogada = derogada.avisos.find((aviso) => aviso.codigo === "derogada")!;
// El aviso se parte por su primer «: »: el estado va en el sello y lo demás, detrás.
const corte = avisoDerogada.texto.indexOf(": ");
const avisoEstado = corte < 0 ? avisoDerogada.texto : avisoDerogada.texto.slice(0, corte + 1);
const avisoResto = corte < 0 ? "" : avisoDerogada.texto.slice(corte + 1);
const citaDestacada = articulo(comparativa.cita);

// La fotografía del hero, en AVIF, WebP y JPEG a varios anchos. Las fuentes
// solo casan en escritorio; el <img> lleva un GIF transparente de un píxel.
const PIXEL = "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";
const foto = ilustracion(audiencia.ilustracion.nombre);
const fotoAnchos = [480, 720, 960, foto.width].filter((ancho) => ancho <= foto.width);
const fotoFuentes = await Promise.all(
  (["avif", "webp", "jpeg"] as const).map(async (formato) => ({
    tipo: `image/${formato}`,
    srcset: (await getImage({ src: foto, widths: fotoAnchos, format: formato === "jpeg" ? "jpg" : formato })).srcSet
      .attribute,
  })),
);

// Lo que ocurre entre la pregunta y la respuesta, en orden: la leyenda del
// díptico, que lo enseña con un caso.
const pasos = [
  "Preguntas con tus palabras",
  "Tu asistente llama a kitlegal",
  "kitlegal lee la norma en el BOE",
  "Comprueba su vigencia",
  "Recibes la respuesta con su cita",
];

// La respuesta de memoria, partida alrededor de las marcas del error.
const expresion = new RegExp(`(${comparativa.marcas.map((m) => m.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|")})`);
const respuesta = comparativa.respuesta.split(expresion).map((trozo) => ({
  texto: trozo,
  marcado: comparativa.marcas.includes(trozo),
}));
---

<section class="bg-lienzo pt-14 pb-16 md:pt-28 md:pb-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-10">
    {/* Como en df6163bc: el titular y la fotografía a la par, centrados. En móvil no hay foto. */}
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div>
    <h1 class="text-balance mb-8 max-w-4xl font-serif text-titular font-semibold text-tinta lg:text-[2.75rem] lg:leading-[1.15]">
      {audiencia.h1}
    </h1>
    <p class="mb-10 max-w-lectura text-lg leading-relaxed text-tenue">{audiencia.subtitulo}</p>

    <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
      <a href={audiencia.secundario.destino} class="inline-flex w-full items-center justify-center gap-2 rounded-sm bg-noche px-7 py-3.5 text-sm font-semibold text-white shadow-md transition-colors hover:bg-noche-2 sm:w-auto">
        <Icono nombre={audiencia.secundario.icono} class="size-[18px] text-sello" />
        {audiencia.secundario.texto}
      </a>
      <a
        href="#diferencia"
        class="inline-flex items-center justify-center gap-1.5 text-sm font-semibold enlace"
      >
        Ver cómo funciona
        <Icono nombre="arrow-downward" class="size-4" />
      </a>
    </div>
    <p class="mt-6 max-w-lectura text-sm leading-relaxed text-tenue">
      Hoy funciona en la app de escritorio de Claude y en Claude Code. En ChatGPT, Codex y Antigravity está{" "}
      <a href="/instalar/#sin-probar" class="enlace">sin probar</a>:
      si lo usas en otro asistente, <a href={enlaceCorreo()} class="font-semibold enlace">cuéntanoslo</a>.
    </p>
    </div>
    {/*
      Solo las fuentes con `media` de escritorio llevan la fotografía: en móvil el
      <img> se queda con un píxel en línea y no se descarga nada.
    */}
    <picture class="hidden lg:block">
      {fotoFuentes.map(({ tipo, srcset }) => (
        <source media="(min-width: 64rem)" type={tipo} srcset={srcset} sizes="50rem" />
      ))}
      <img
        src={PIXEL}
        alt={audiencia.ilustracion.alt}
        width={foto.width}
        height={foto.height}
        fetchpriority="high"
        decoding="async"
        class:list={["aspect-[4/3] w-full rounded-xl border border-linea object-cover shadow-lg", audiencia.ilustracion.foco]}
      />
    </picture>
    </div>
  </div>
</section>

{/* El díptico, la primera sección bajo el hero: su frase de entrada es el título. */}
<section id="diferencia" aria-labelledby="titulo-diferencia" class="border-t border-linea bg-panel py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-10">
    <h2 id="titulo-diferencia" class="text-balance mb-8 font-serif text-3xl font-semibold text-tinta md:mb-10 md:text-4xl">
      La misma consulta, dos respuestas: de memoria y con kitlegal.
    </h2>
    <figure aria-label="Cómo funciona: la misma consulta, de memoria y con kitlegal">
      <figcaption>
        <span class="block rounded-md border border-linea bg-white px-5 py-4 font-serif text-lg font-semibold text-tinta">
          <span class="font-sans text-sm text-tenue">Consulta:</span>{" "}
          {comparativa.consulta}
        </span>
      </figcaption>
      <div class="mt-5 grid grid-cols-1 items-start gap-8 lg:grid-cols-2">
        <article
          aria-labelledby="titulo-sin"
          class="flex flex-col rounded-lg border border-derogada-borde/70 bg-white p-6 shadow-[0_2px_12px_rgba(239,68,68,0.05)] sm:p-8"
        >
          <div class="space-y-6">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-linea pb-4">
              <h3 id="titulo-sin" class="flex items-center gap-2 text-sm font-semibold text-derogada-tinta">
                <Icono nombre="cancel" class="size-5 text-derogada" />
                Asistente de IA sin kitlegal
              </h3>
              {/* El juicio de la página, en Inter y sin forma de sello: la estampa en mono es para lo que llega del BOE. */}
              <span class="text-xs font-semibold text-derogada-tinta">{comparativa.insignia}</span>
            </div>
            <div>
            <p class="mb-2 text-xs font-medium text-derogada-tinta">Respuesta de ejemplo: el error típico de citar de memoria</p>
            <p class="leading-relaxed text-tinta italic">
              {
                respuesta.map(({ texto, marcado }) =>
                  marcado ? (
                    <mark class="-mx-0.5 rounded-sm bg-derogada-fondo px-0.5 font-semibold text-derogada-tinta not-italic">
                      {texto}
                    </mark>
                  ) : (
                    texto
                  ),
                )
              }
            </p>
            </div>
            <div class="space-y-1.5 rounded-md bg-derogada-fondo/80 p-4 text-xs text-derogada-tinta">
              <p class="flex items-center gap-1.5 text-sm font-bold">
                <Icono nombre="error" class="size-[18px] text-derogada" />
                {comparativa.alertaTitulo}
              </p>
              <p class="leading-relaxed">{comparativa.alertaTexto}</p>
            </div>
          </div>
        </article>

        <article
          aria-labelledby="titulo-con"
          class="flex flex-col rounded-lg border-2 border-vigente/40 bg-white p-6 shadow-[0_4px_20px_rgba(16,185,129,0.08)] sm:p-8"
        >
          <div class="space-y-6">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-linea pb-4">
              <h3 id="titulo-con" class="flex items-center gap-2 text-sm font-semibold text-vigente-tinta">
                <Icono nombre="verified" class="size-5 text-vigente" />
                Tu asistente con kitlegal
              </h3>
              {/* Como la insignia roja: una etiqueta de la página, en Inter y sin forma de sello. */}
              <span class="text-xs font-semibold text-vigente-tinta">Cita del BOE</span>
            </div>
            <div role="note" class="border-b border-linea pb-6 text-xs">
              <p class="mb-2 flex items-start gap-1.5 text-sm text-tinta">
                <Icono nombre="verified" class="mt-0.5 size-4 shrink-0 text-vigente" />
                <span>
                  <strong class="font-semibold">Detectado antes de citar.</strong> Tu asistente iba a apoyarse en la
                  Ley 30/1992; kitlegal consulta el BOE y le avisa:
                </span>
              </p>
              <p class="font-mono leading-relaxed">
                {/* El estado del sobre («⚠ NORMA DEROGADA») va en un sello que no se parte; el resto del aviso le sigue como texto. */}
                <span class="whitespace-nowrap rounded-sm border border-derogada-borde bg-derogada-fondo px-1.5 py-0.5 font-semibold text-derogada-tinta">
                  {avisoEstado}
                </span>
                {avisoResto && <span class="font-semibold text-derogada-tinta">{avisoResto}</span>}{" "}
                <a href={derogada.enlace} class="enlace">
                  {derogada.referencia} <span class="whitespace-nowrap">[{derogada.norma}]</span>
                </a>
              </p>
              <p class="mt-1.5 font-mono text-tenue">
                Metadatos del BOE · {fechaCorta(derogada.fechaConsulta)} · {huellaCorta(derogada.hash)}
              </p>
            </div>
            <div>
              <CitaArticulo id={comparativa.cita} variante="destacada" />
              <details class="group mt-4 max-w-lectura text-xs leading-relaxed text-tenue">
                <summary class="inline-flex cursor-pointer list-none items-center gap-1 font-medium underline decoration-linea-2 underline-offset-2 hover:text-tinta [&::-webkit-details-marker]:hidden">
                  Cómo se lee la cita
                  <Icono nombre="expand-more" class="size-4 transition-transform group-open:rotate-180" />
                </summary>
                <p class="mt-2">
                  <span class="font-mono text-tinta">{citaDestacada.norma}</span> es el identificador de la norma en el
                  BOE, y el bloque <span class="font-mono text-tinta">{citaDestacada.bloque}</span>, la parte del texto
                  consolidado que contiene el artículo. La huella del texto (<span class="font-mono text-tinta">sha256</span>)
                  se calcula sobre lo leído: si el BOE cambia el artículo, la huella cambia y se nota.
                </p>
              </details>
            </div>
          </div>
        </article>
      </div>

      {/*
        Los pasos, en una línea discreta bajo las dos tarjetas, sin reglas de color.
        Hasta xl, una lista corta; desde xl (1280), el título encima y los cinco
        pasos en una sola línea centrada, con flechas en gris.
      */}
      <div class="mt-10 text-sm text-tenue xl:text-center xl:text-[0.8125rem]">
        <p id="titulo-pasos" class="mb-2 font-semibold text-tinta xl:mb-1.5">Entre la pregunta y la respuesta</p>
        <ol aria-labelledby="titulo-pasos" class="space-y-1 xl:flex xl:items-baseline xl:justify-center xl:gap-x-3 xl:space-y-0">
          {
            pasos.map((paso, indice) => (
              <li class="flex items-baseline gap-2">
                {indice > 0 && <Icono nombre="arrow-forward" class="hidden size-3.5 shrink-0 self-center text-linea-2 xl:block" />}
                <span class="font-semibold text-tinta tabular-nums">{indice + 1}</span>
                <span>{paso}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </figure>

    <div class="mt-12 grid grid-cols-1 gap-4 border-t border-linea pt-8 text-sm md:grid-cols-2">
      <p class="flex items-start gap-3 text-tenue">
        <Icono nombre="download" class="mt-0.5 size-5 text-sello" />
        <span>
          Se instala una vez en la app de escritorio de Claude, como una extensión: sin terminal y sin saber programar.
          Con la app abierta, también puedes preguntar desde Claude en el móvil o en la web.{" "}
          <a href="/instalar/" class="font-semibold enlace">Instalar kitlegal</a>
        </span>
      </p>
      <p class="flex items-start gap-3 text-tenue">
        <Icono nombre="mail" class="mt-0.5 size-5 text-sello" />
        <span>
          ¿Qué le falta para tu despacho? Escríbenos a{" "}
          <a href={enlaceCorreo()} class="font-semibold enlace">{CORREO}</a>.
        </span>
      </p>
    </div>
  </div>
</section>

<ComparativaMercado>
  {/*
    Las garantías, con presencia propia: un bloque blanco sobre el panel de la
    comparativa. En lg, el encabezado a la izquierda y las cuatro a la derecha.
  */}
  <div
    id="pilares"
    aria-labelledby="titulo-pilares"
    class="mt-16 grid grid-cols-1 gap-8 rounded-xl border border-linea bg-white p-6 shadow-sm sm:p-10 md:mt-24 lg:grid-cols-[17rem_minmax(0,1fr)] lg:grid-rows-[auto_1fr] lg:gap-x-14 lg:gap-y-6"
  >
    <div>
      <h3 id="titulo-pilares" class="text-balance font-serif text-2xl font-semibold text-tinta md:text-3xl">{garantias.titulo}</h3>
      <p class="mt-3 max-w-lectura leading-relaxed text-tenue">{garantias.texto}</p>
    </div>
    <div class="lg:col-start-2 lg:row-span-2 lg:row-start-1">
      {/* Los dos frenos de un despacho, a la par y en la misma fila: la jurisprudencia inventada y adónde van sus asuntos. Debajo, las dos de la norma. */}
      <ul class="grid grid-cols-1 gap-x-10 md:grid-cols-2">
        {
          [
            { icono: "gavel", ...garantias.sentencias },
            { icono: "shield", ...garantias.secreto },
          ].map(({ icono, titulo, texto }) => (
            <li class="border-t-2 border-sello pt-5 pb-6 md:pb-8">
              <Icono nombre={icono} class="mb-3 size-7 text-sello md:size-8" />
              <p>
                <strong class="block text-pretty font-serif text-xl font-semibold text-tinta md:text-2xl">{titulo}.</strong>
                <span class="mt-2 block max-w-lectura leading-relaxed text-tenue">{texto}</span>
              </p>
            </li>
          ))
        }
        {
          [
            { icono: "menu-book", ...garantias.norma },
            { icono: "event-available", ...garantias.vigencia },
          ].map(({ icono, titulo, texto }) => (
            <li class="flex items-start gap-3 border-t border-linea py-5 text-sm leading-relaxed text-tenue">
              <Icono nombre={icono} class="mt-0.5 size-5 shrink-0 text-sello" />
              <p>
                <strong class="block font-serif text-base font-semibold text-tinta">{titulo}.</strong>
                {texto}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
    {/* En móvil, el enlace cierra el bloque; en lg va bajo el encabezado. */}
    {
      garantias.enlace && (
        <a
          href={garantias.enlace.destino}
          class="self-start justify-self-start text-sm font-semibold enlace lg:col-start-1 lg:row-start-2"
        >
          {garantias.enlace.texto}
          <Icono nombre="arrow-forward" class="ml-1 inline size-4 align-[-0.2em]" />
        </a>
      )
    }
  </div>
</ComparativaMercado>

<section id="casos" aria-labelledby="titulo-casos" class="border-t border-linea bg-white py-16 md:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-10">
    <div class="mb-10 flex flex-col justify-between gap-4 md:mb-16 md:gap-6 md:flex-row md:items-end">
      <div>
        <h2 id="titulo-casos" class="text-balance font-serif text-3xl font-semibold text-tinta md:text-4xl">
          Consultas habituales, con su cita
        </h2>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-tenue">
        Cada pregunta lleva el fragmento literal del BOE que la responde, con la norma y el bloque del que sale, tal
        como lo devuelve kitlegal.
      </p>
    </div>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-8">
      {
        audiencia.casos.map(({ icono: nombre, etiqueta, pregunta, cita, consulta }) => (
          <article class="flex flex-col rounded-lg border border-linea bg-lienzo p-6 sm:p-8">
            <div>
              <p class="mb-3 flex items-center gap-2">
                <Icono nombre={nombre} class="size-[18px] text-sello" />
                <span class="text-sm font-medium text-tenue">{etiqueta}</span>
              </p>
              <h3 class="mb-3 text-pretty font-serif text-lg font-semibold text-tinta">{pregunta}</h3>
            </div>
            {/* En móvil, la cita se pliega para que se lean las cuatro preguntas de un vistazo; en escritorio va abierta. */}
            <details class="group border-t border-linea pt-3 md:hidden">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-2 text-sm font-medium text-tenue hover:text-tinta [&::-webkit-details-marker]:hidden">
                <span>
                  Ver la cita: <span class="text-sello-tinta">{articulo(cita).referencia}</span>
                </span>
                <Icono nombre="expand-more" class="size-5 shrink-0 transition-transform group-open:rotate-180" />
              </summary>
              <div class="mt-4">
                <CitaArticulo id={cita} />
              </div>
            </details>
            <div class="hidden md:flex md:flex-1 md:flex-col">
              <CitaArticulo id={cita} />
            </div>
            {consulta ? (
              <a
                href={rutaDeConsulta(consulta)}
                class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold enlace"
              >
                Ver la respuesta, punto por punto
                <Icono nombre="arrow-forward" class="size-4" />
              </a>
            ) : (
              <a
                href={articulo(cita).enlace}
                class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold enlace"
              >
                Leer el artículo en boe.es
                <Icono nombre="open-in-new" class="size-4" />
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

{
  contacto && (
    <section id="contacto" aria-labelledby="titulo-contacto" class="border-t border-linea bg-panel py-16 md:py-32">
      <div class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-4 sm:px-10 lg:grid-cols-2 lg:gap-16">
        <div>
          <h2 id="titulo-contacto" class="text-balance mb-4 font-serif text-3xl font-semibold text-tinta md:text-4xl">
            {contacto.titulo}
          </h2>
          <p class="mb-8 max-w-lectura leading-relaxed text-tenue">{contacto.texto}</p>
          <a
            href={enlaceCorreo(contacto.asunto)}
            class="inline-flex items-center justify-center gap-2 rounded-sm bg-noche px-7 py-3.5 text-sm font-semibold text-white shadow-md transition-colors hover:bg-noche-2"
          >
            <Icono nombre="mail" class="size-[18px] text-sello" />
            {CORREO}
          </a>
          {/* El aviso, junto al botón que abre el correo: se lee antes de escribir. */}
          <p class="mt-3.5 max-w-lectura text-xs leading-relaxed text-tenue">{contacto.aviso}</p>
        </div>
        <div class="rounded-lg border border-linea bg-white p-6 shadow-sm sm:p-8">
          <h3 class="mb-4 font-serif text-xl font-semibold text-tinta">Lo que más nos ayuda saber</h3>
          <ul class="mb-6 space-y-3 text-sm leading-relaxed text-tenue">
            {contacto.peticiones.map((peticion) => (
              <li class="flex items-start gap-2.5">
                <Icono nombre="chat" class="mt-0.5 size-[18px] text-sello" />
                <span>{peticion}</span>
              </li>
            ))}
          </ul>
          <h3 class="mb-1 border-t border-linea pt-5 font-serif text-lg font-semibold text-tinta">Todavía no lo hace</h3>
          <p class="mb-3 text-sm text-tenue">Estamos trabajando en ello:</p>
          <ul class="mb-6 space-y-2.5 text-sm leading-relaxed text-tenue">
            {contacto.enMarcha.map((frase) => (
              <li class="flex items-start gap-2.5">
                <Icono nombre="pending" class="mt-0.5 size-[18px] text-sello" />
                <span>{frase}</span>
              </li>
            ))}
          </ul>
          <h3 class="mb-3 font-serif text-lg font-semibold text-tinta">Lo que no hará</h3>
          <div class="flex items-start gap-2.5 text-sm leading-relaxed text-tenue">
            <Icono nombre="block" class="mt-0.5 size-[18px] text-tenue" />
            <details class="group">
              <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                {contacto.descartado.resumen}{" "}
                <span class="font-semibold text-tinta underline underline-offset-2 group-open:hidden">Por qué</span>
              </summary>
              <p class="mt-1">
                {contacto.descartado.explicacion}{" "}
                <a href={contacto.detalle.destino} class="font-semibold text-tinta underline underline-offset-2">
                  {contacto.detalle.texto}
                </a>
              </p>
            </details>
          </div>
        </div>
      </div>
    </section>
  )
}

<section aria-labelledby="titulo-cta" class="bg-noche py-16 text-white md:py-32">
  <div class="mx-auto max-w-4xl px-4 text-center sm:px-10">
    <h2 id="titulo-cta" class="text-balance mb-6 font-serif text-3xl leading-tight font-semibold md:text-5xl">{audiencia.cta.titulo}</h2>
    <p class="mx-auto mb-10 max-w-2xl text-lg leading-relaxed text-sobre-noche">{audiencia.cta.texto}</p>
    <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href="/instalar/"
        class="inline-flex w-full items-center justify-center gap-2 rounded-sm bg-white px-7 py-3.5 text-sm font-semibold text-noche shadow-lg transition-colors hover:bg-panel sm:w-auto"
      >
        <Icono nombre="download" class="size-[18px] text-sello" />
        Instalar kitlegal
      </a>
      <a
        href="/como-se-evalua/"
