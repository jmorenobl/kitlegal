---
// Comparativa de mercado: kitlegal frente a las bases de datos de las
// editoriales y a un asistente generalista sin fuentes. Lo que se dice de los
// demás lleva su nota, con la fuente y la fecha de consulta; lo que no se ha
// podido comprobar se dice así, sin suponerlo.
import { formatoEntero, numeroDeMunicipios } from "../lib/proyecto";
import Icono from "./Icono.astro";
import Nota from "./Nota.astro";

interface Celda {
  destacado: string;
  subtexto: string;
  // El número de la fuente de `fuentes` que respalda la celda, si la hay.
  nota?: number;
}

interface FilaComparativa {
  criterio: string;
  kitlegal: Celda;
  editoriales: Celda;
  generalista: Celda;
}

const CONSULTA = "5 de noviembre de 2026";

const fuentes = [
  {
    texto: `Páginas de Aranzadi One, de Lefebvre y de precios de vLex, consultadas el ${CONSULTA}: ninguna publica la tarifa de su base de datos jurídica.`,
    enlaces: [
      { texto: "aranzadilaley.es", url: "https://www.aranzadilaley.es/productos/aranzadi-one" },
      { texto: "lefebvre.es", url: "https://lefebvre.es/" },
      { texto: "vlex.es/pricing", url: "https://vlex.es/pricing" },
    ],
  },
  {
    texto: `Precios de Claude, consultados el ${CONSULTA}: el plan Pro cuesta 20 $ al mes con pago mensual, impuestos aparte.`,
    enlaces: [{ texto: "claude.com/pricing", url: "https://claude.com/pricing" }],
  },
  {
    texto: `Aranzadi One: «Tu asistente de inteligencia artificial jurídica incluido» y «Legislación completa y actualizada». Vincent: «combina la base de datos jurídica global de vLex con IA». GenIA-L, presentada por Lefebvre el 20 de septiembre de 2023. Consultadas el ${CONSULTA}.`,
    enlaces: [
      { texto: "aranzadilaley.es", url: "https://www.aranzadilaley.es/productos/aranzadi-one" },
      { texto: "vlex.es/vincent-ai", url: "https://vlex.es/vincent-ai" },
      {
        texto: "elderecho.com",
        url: "https://elderecho.com/genia-l-de-lefebvre-la-primera-solucion-basada-en-ia-generativa-para-profesionales-del-sector-juridico",
      },
    ],
  },
  {
    texto: `Nota de prensa del TSJ de Canarias, «El TSJ de Canarias multa a un abogado por presentar un recurso con citas jurisprudenciales inexistentes», 30 de julio de 2026, consultada el ${CONSULTA}.`,
    enlaces: [
      {
        texto: "poderjudicial.es",
        url: "https://www.poderjudicial.es/cgpj/es/Poder-Judicial/Tribunales-Superiores-de-Justicia/TSJ-Canarias/Noticias-Judiciales-TSJ-Canarias/El-TSJ-de-Canarias-multa-a-un-abogado-por-presentar-un-recurso-con-citas-jurisprudenciales-inexistentes-",
      },
    ],
  },
];

const columnas = {
  kitlegal: { nombre: "kitlegal", detalle: "En el asistente que ya usas" },
  editoriales: { nombre: "Bases de las editoriales", detalle: "Aranzadi LA LEY, Lefebvre, vLex" },
  generalista: { nombre: "Asistente sin fuentes", detalle: "Claude, ChatGPT o Copilot, sin kitlegal" },
};

const municipios = formatoEntero(numeroDeMunicipios());

const filas: FilaComparativa[] = [
  {
    criterio: "Precio",
    kitlegal: {
      destacado: "0 €, software libre (EUPL-1.2)",
      subtexto: "Se suma al asistente que ya usas, que se paga aparte.",
    },
    editoriales: {
      destacado: "Bajo presupuesto",
      subtexto: "No publican la tarifa en su web.",
      nota: 1,
    },
    generalista: {
      destacado: "Desde 20 $ al mes",
      subtexto: "Claude Pro, impuestos aparte. kitlegal también necesita un asistente.",
      nota: 2,
    },
  },
  {
    criterio: "Dónde se usa",
    kitlegal: {
      destacado: "En tu asistente",
      subtexto: "La app de escritorio de Claude y Claude Code.",
    },
    editoriales: {
      destacado: "Dentro de su plataforma",
      subtexto: "Con su propia IA: Allegra en Aranzadi One, GenIA-L en Lefebvre, Vincent en vLex.",
      nota: 3,
    },
    generalista: {
      destacado: "En su chat",
      subtexto: "La conversación de siempre, sin una fuente jurídica detrás.",
    },
  },
  {
    criterio: "De dónde sale la cita",
    kitlegal: {
      destacado: "Del texto consolidado del BOE",
      subtexto: "Leído al responder: norma, bloque, fecha de consulta y huella del texto.",
    },
    editoriales: {
      destacado: "De su base de datos",
      subtexto: "Legislación, jurisprudencia y doctrina de la editorial.",
      nota: 3,
    },
    generalista: {
      destacado: "De memoria",
      subtexto: "Lo que aprendió el modelo. Los tribunales ya han multado a abogados por citas inexistentes.",
      nota: 4,
    },
  },
  {
    criterio: "Vigencia",
    kitlegal: {
      destacado: "Aviso del BOE antes de citar",
      subtexto: "Si el BOE marca la norma como derogada o con la vigencia agotada, lo dice primero.",
    },
    editoriales: {
      destacado: "Legislación actualizada",
      subtexto: "Así lo anuncia Aranzadi One, sin detallar cómo comprueba la vigencia de cada norma.",
      nota: 3,
    },
    generalista: {
      destacado: "Sin comprobar",
      subtexto: "No lee el BOE, así que no sabe si una norma sigue en vigor.",
    },
  },
  {
    criterio: "Territorio",
    kitlegal: {
      destacado: `${municipios} municipios del INE`,
      subtexto: "Provincia, comunidad, DIR3 del ayuntamiento y régimen común o foral.",
    },
    editoriales: {
      destacado: "Sin comprobar",
      subtexto: "No hemos encontrado en sus webs cómo lo resuelven.",
    },
    generalista: {
      destacado: "De memoria",
      subtexto: "Sin consultar el registro de municipios del INE.",
    },
  },
];
---

<section id="comparativa" aria-labelledby="titulo-comparativa" class="border-t border-linea bg-lienzo py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-10">
    <div class="mb-16 max-w-3xl">
      <h2 id="titulo-comparativa" class="text-balance mb-4 font-serif text-3xl font-semibold text-tinta md:text-4xl">
        kitlegal frente a las bases de datos de las editoriales y a un asistente sin fuentes
      </h2>
      <p class="max-w-prose leading-relaxed text-tenue">
        Las bases de datos de las editoriales ya traen su propia IA, dentro de su plataforma. Un asistente generalista
        responde de memoria. kitlegal no sustituye a ninguno de los dos: da al asistente que ya usas el texto consolidado
        del BOE y la cita de cada artículo.
      </p>
    </div>

    <div
      role="region"
      aria-label="Comparativa de kitlegal, las bases de las editoriales y un asistente sin fuentes"
      tabindex="0"
      class="hidden overflow-x-auto rounded-xl border border-linea bg-white shadow-sm md:block"
    >
      <table class="w-full border-collapse text-left">
        <caption class="sr-only">
          kitlegal frente a las bases de datos de las editoriales y a un asistente sin fuentes, criterio por criterio.
          Los números remiten a las fuentes bajo la tabla.
        </caption>
        <thead>
          <tr class="border-b border-linea bg-panel/60">
            <th scope="col" class="w-1/5 p-5 font-mono text-xs font-semibold uppercase text-tenue">Criterio</th>
            <th scope="col" class="w-[30%] border-x-2 border-agente bg-panel-2/70 p-5">
              <div class="flex items-center justify-between gap-2">
                <span class="font-serif text-lg font-bold text-tinta">kitlegal</span>
                <span class="rounded-sm border border-vigente-borde bg-vigente-fondo px-2 py-0.5 font-mono text-estampa font-bold uppercase text-vigente-tinta">
                  Software libre
                </span>
              </div>
              <p class="mt-1 font-mono text-xs text-agente font-medium">{columnas.kitlegal.detalle}</p>
            </th>
            {
              [columnas.editoriales, columnas.generalista].map(({ nombre, detalle }) => (
                <th scope="col" class="w-1/4 p-5">
                  <span class="font-serif text-base font-semibold text-tinta">{nombre}</span>
                  <p class="mt-1 font-mono text-[11px] font-normal text-tenue">{detalle}</p>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody class="divide-y divide-linea">
          {
            filas.map((fila) => (
              <tr class="transition-colors hover:bg-papel/70">
                <th scope="row" class="p-5 align-top font-sans text-sm font-semibold text-tinta">
                  {fila.criterio}
                </th>
                <td class="border-x-2 border-agente bg-panel/30 p-5 align-top">
                  <p class="flex items-center gap-1.5 font-sans text-sm font-bold text-tinta">
                    <Icono nombre="check" class="size-4 text-vigente" />
                    <span>{fila.kitlegal.destacado}</span>
                  </p>
                  <p class="mt-1 text-xs leading-relaxed text-tenue">{fila.kitlegal.subtexto}</p>
                </td>
                {[fila.editoriales, fila.generalista].map((celda) => (
                  <td class="p-5 align-top">
                    <p class="font-sans text-sm font-medium text-tinta">{celda.destacado}</p>
                    <p class="mt-1 text-xs leading-relaxed text-tenue">
                      {celda.subtexto}
                      {celda.nota && <Nota numero={celda.nota} />}
                    </p>
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <ol class="space-y-6 md:hidden" aria-label="Comparativa, criterio por criterio">
      {
        filas.map((fila) => (
          <li class="rounded-lg border border-linea bg-white">
            <h3 class="border-b border-linea px-5 py-3 font-serif text-lg font-semibold text-tinta">{fila.criterio}</h3>
            <dl class="divide-y divide-linea">
              <div class="bg-panel/40 px-5 py-4">
                <dt class="font-mono text-estampa font-semibold uppercase text-agente">kitlegal</dt>
                <dd class="mt-1 flex items-center gap-1.5 text-sm font-bold text-tinta">
                  <Icono nombre="check" class="size-4 text-vigente" />
                  {fila.kitlegal.destacado}
                </dd>
                <dd class="mt-1 text-sm leading-relaxed text-tenue">{fila.kitlegal.subtexto}</dd>
              </div>
              {[
                [columnas.editoriales.nombre, fila.editoriales] as const,
                [columnas.generalista.nombre, fila.generalista] as const,
              ].map(([nombre, celda]) => (
                <div class="px-5 py-4">
                  <dt class="font-mono text-estampa font-semibold uppercase text-tenue">{nombre}</dt>
                  <dd class="mt-1 text-sm font-medium text-tinta">{celda.destacado}</dd>
                  <dd class="mt-1 text-sm leading-relaxed text-tenue">
                    {celda.subtexto}
                    {celda.nota && <Nota numero={celda.nota} />}
                  </dd>
                </div>
              ))}
            </dl>
          </li>
        ))
      }
    </ol>

    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
      <div class="flex items-start gap-3.5 rounded-lg border border-linea bg-white p-5 shadow-xs">
        <Icono nombre="gavel" class="mt-0.5 size-5 text-sello" />
        <p class="text-xs leading-relaxed text-tenue">
          <strong class="font-sans font-semibold text-tinta">Lo que responde quien firma.</strong> Los tribunales ya han
          multado a abogados por citar sentencias inexistentes y han dado traslado al colegio<Nota numero={4} />. Con kitlegal, tu asistente solo cita una norma que acaba de leer en el BOE, y una sentencia, solo con
          su documento delante, que traes tú.
        </p>
      </div>
      <div class="flex items-start gap-3.5 rounded-lg border border-linea bg-white p-5 shadow-xs">
        <Icono nombre="shield" class="mt-0.5 size-5 text-agente" />
        <p class="text-xs leading-relaxed text-tenue">
          <strong class="font-sans font-semibold text-tinta">El secreto profesional.</strong> kitlegal es un programa
          que corre en tu ordenador: lee los datos abiertos del BOE y guarda las normas consultadas en tu disco, sin
          cuentas ni servidores de kitlegal por medio. Lo que escribes a tu asistente sigue las condiciones de ese
          asistente.
        </p>
      </div>
    </div>

    <div class="mt-10 border-t border-linea pt-6">
      <h3 class="font-mono text-estampa font-semibold uppercase text-tinta">Fuentes de la comparativa</h3>
      <ol class="mt-3 max-w-prose space-y-2 text-xs leading-relaxed text-tenue">
        {
          fuentes.map(({ texto, enlaces }, indice) => (
            <li id={`fuente-${indice + 1}`} class="flex gap-2 target:text-tinta">
              <span class="font-mono text-tinta">{indice + 1}.</span>
              <span>
                {texto}{" "}
                {enlaces.map(({ texto: nombre, url }, orden) => (
                  <>
                    {orden > 0 && " · "}
                    <a href={url} class="text-agente underline underline-offset-2">
                      {nombre}
                    </a>
                  </>
                ))}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
