---
// La llamada a una nota de fuente: un número volado que enlaza con
// `#fuente-N`, la lista de fuentes de la sección. El cuerpo no baja de 11 px y
// la zona táctil se amplía a unos 24 px con un ::after, sin mover el texto.
interface Props {
  numero: number;
}

const { numero } = Astro.props;
---

<sup class="leading-none"
  ><a
    href={`#fuente-${numero}`}
    class="relative ml-0.5 text-[0.6875rem] font-semibold text-agente tabular-nums underline underline-offset-2 after:absolute after:-inset-x-2 after:-inset-y-2.5 after:content-['']"
    ><span class="sr-only">Fuente </span>{numero}</a
  ></sup>
