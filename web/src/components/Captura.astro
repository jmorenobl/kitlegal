---
// Una captura de la app de Claude, de src/assets/instalar/, con lo que hay que
// pulsar recuadrado en ámbar. Se nombra por su fichero sin extensión; el pie,
// opcional, dice qué se ve. Las capturas salen de una grabación de la
// instalación, con el nombre de la cuenta tapado.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  nombre: string;
  alt: string;
  pie?: string;
}

const { nombre, alt, pie } = Astro.props;

const ficheros = import.meta.glob<{ default: ImageMetadata }>("../assets/instalar/*.png", { eager: true });
const imagen = ficheros[`../assets/instalar/${nombre}.png`]?.default;
if (!imagen) throw new Error(`Captura: no hay ninguna imagen ${nombre}.png en src/assets/instalar/`);
const anchos = [480, 720, imagen.width].filter((ancho) => ancho <= imagen.width);
---

<figure class="my-4 space-y-2">
  <Picture
    src={imagen}
    alt={alt}
    formats={["avif", "webp"]}
    widths={anchos}
    sizes="(min-width: 768px) 688px, 100vw"
    loading="lazy"
    class="h-auto w-full rounded-lg border border-linea shadow-sm"
    pictureAttributes={{ class: "block" }}
  />
  {pie && <figcaption class="text-sm text-tenue">{pie}</figcaption>}
</figure>
