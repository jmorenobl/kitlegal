---
import { consultas } from "../../data/consultas";
import { consultas as pagina } from "../../data/paginas";
import Base from "../../layouts/Base.astro";
import { chipVigente, pagina as contenedor, punto } from "../../lib/clases";
import { migas } from "../../lib/estructurados";
---

<Base
  titulo={pagina.titulo}
  descripcion={pagina.descripcion}
  imagen="consultas"
  datos={migas({ nombre: "Consultas", ruta: pagina.ruta })}
>
  <header class:list={[contenedor, "flex flex-col items-center gap-[22px] pt-16 text-center"]}>
    <p class={chipVigente}>Consultas</p>
    <h1 class="font-titular text-h1-pagina font-bold text-balance">Consultas habituales, con su cita</h1>
    <p class="max-w-[760px] text-entradilla text-pretty text-tenue">
      La pregunta tal como se suele hacer y lo que dice la norma vigente, punto por punto. Cada afirmación va con el
      fragmento literal del BOE que la sostiene, tal como lo devuelve kitlegal.
    </p>
  </header>
  <ul
    class:list={[contenedor, "grid grid-cols-[repeat(auto-fill,minmax(min(340px,100%),1fr))] gap-5 pt-16"]}
  >
    {
      consultas.map(({ slug, etiqueta, punto: color, pregunta, respuesta }) => (
        <li class="flex">
          <a
            href={`/consultas/${slug}/`}
            class="flex w-full flex-col gap-3.5 rounded-3xl border border-linea bg-white p-7 transition-[box-shadow,border-color] hover:border-linea-hover hover:shadow-tarjeta max-sm:p-6"
          >
            <span class="flex items-center gap-2 self-start rounded-full bg-chip px-3 py-[5px] text-[13px] font-semibold text-tenue">
              <span aria-hidden="true" class:list={["size-2 rounded-full", punto[color]]} />
              {etiqueta}
            </span>
            <h2 class="font-titular text-2xl leading-[1.15] font-bold tracking-[-0.01em]">{pregunta}</h2>
            <p class="text-base leading-[1.6] text-tenue">{respuesta}</p>
            <span class="mt-auto pt-2 text-[15px] font-semibold text-agente">Ver la respuesta, con su cita →</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
