---
// Una consulta de consultas.ts: la pregunta, la respuesta corta y cada punto
// con la cita que lo sostiene.
import type { GetStaticPaths } from "astro";
import CitaArticulo from "../../components/CitaArticulo.astro";
import { type Consulta, consultas } from "../../data/consultas";
import { consultas as indice } from "../../data/paginas";
import Base from "../../layouts/Base.astro";
import { chipPequeno, etiquetaSeccion } from "../../lib/clases";
import { articulo } from "../../lib/citas";
import { migas, pregunta } from "../../lib/estructurados";
import { imagenDeConsulta } from "../../lib/imagenes";

export const getStaticPaths: GetStaticPaths = () =>
  consultas.map((consulta) => ({ params: { consulta: consulta.slug }, props: { consulta } }));

interface Props {
  consulta: Consulta;
}

const { consulta } = Astro.props;
const ruta = `/consultas/${consulta.slug}/`;
const otras = consultas.filter(({ slug }) => slug !== consulta.slug);
const columna = "mx-auto w-full max-w-[960px] px-margen";
// Los avisos de vigencia de una norma van con la cita principal; un punto solo
// los repite si cita otra norma.
const normaPrincipal = articulo(consulta.cita).norma;
---

<Base
  titulo={consulta.titulo}
  descripcion={consulta.descripcion}
  imagen={imagenDeConsulta(consulta.slug)}
  datos={[
    ...migas({ nombre: "Consultas", ruta: indice.ruta }, { nombre: consulta.pregunta, ruta }),
    ...pregunta(consulta.pregunta, consulta.respuesta),
  ]}
>
  <article>
    <header class:list={[columna, "flex flex-col gap-[22px] pt-10"]}>
      <nav aria-label="Migas" class="flex flex-wrap items-center gap-2 text-sm font-medium text-tenue">
        <a href={indice.ruta} class="tocable text-agente">Consultas</a>
        <span aria-hidden="true">›</span>
        <span>{consulta.etiqueta}</span>
      </nav>
      <h1 class="font-titular text-h1-consulta font-bold text-balance">{consulta.pregunta}</h1>
      <div class="overflow-hidden rounded-3xl border border-linea bg-white shadow-destacada">
        <div class="flex flex-col gap-3 border-b border-linea-suave p-tarjeta">
          <span class:list={[chipPequeno, "bg-panel text-agente"]}>La respuesta corta</span>
          <p class="text-[clamp(19px,2.2vw,23px)] leading-[1.5] font-medium text-pretty">{consulta.respuesta}</p>
        </div>
        <div class="flex flex-col gap-3 bg-pie-tarjeta p-tarjeta">
          <span class:list={[chipPequeno, "bg-vigente-fondo text-vigente-tinta"]}>Texto literal del BOE</span>
          <CitaArticulo id={consulta.cita} variante="consulta" />
        </div>
      </div>
    </header>

    <section aria-labelledby="titulo-puntos" class:list={[columna, "flex flex-col gap-5 pt-seccion-1"]}>
      <div class="flex flex-col gap-2.5">
        <p class={etiquetaSeccion}>Punto por punto</p>
        <h2 id="titulo-puntos" class="font-titular text-[clamp(28px,3.6vw,40px)] leading-[1.08] font-bold tracking-[-0.02em]">
          Lo que conviene saber
        </h2>
        <p class="text-base leading-[1.6] text-tenue">Cada punto va con el fragmento literal del BOE que lo sostiene.</p>
      </div>
      {
        consulta.puntos.map(({ titulo, texto, cita }, numero) => (
          <article class="grid grid-cols-[repeat(auto-fit,minmax(min(340px,100%),1fr))] overflow-hidden rounded-3xl border border-linea bg-white">
            <div class="flex flex-col gap-2.5 p-[clamp(22px,3vw,30px)]">
              <div class="flex items-center gap-3">
                <span
                  aria-hidden="true"
                  class="grid size-[30px] flex-none place-items-center rounded-full bg-tinta text-[13px] font-bold text-white"
                >
                  {numero + 1}
                </span>
                <h3 class="text-xl leading-[1.25] font-bold">{titulo}</h3>
              </div>
              <p class="text-base leading-[1.65] text-tinta-cuerpo">{texto}</p>
            </div>
            <div class="border-l border-linea-suave bg-superficie-2 p-[clamp(22px,3vw,30px)]">
              <CitaArticulo id={cita} variante="punto" avisos={articulo(cita).norma !== normaPrincipal} />
            </div>
          </article>
        ))
      }
    </section>

    <div
      class:list={[columna, "grid grid-cols-[repeat(auto-fit,minmax(min(380px,100%),1fr))] gap-5 pt-seccion-1"]}
    >
      <section
        aria-labelledby="titulo-limites"
        class="flex flex-col gap-3.5 rounded-3xl border border-sello-borde bg-sello-fondo p-tarjeta"
      >
        <h2 id="titulo-limites" class="text-xl font-bold">Lo que esta página no te dice</h2>
        <ul class="flex flex-col gap-3.5">
          {
            [
              ...consulta.limites,
              "No es asesoramiento jurídico: cita la norma, no valora tu caso. Para una decisión con consecuencias, acude a un profesional.",
            ].map((limite) => (
              <li class="flex gap-3 text-[15px] leading-[1.6] text-tenue">
                <span aria-hidden="true" class="mt-2 size-2 flex-none rounded-full bg-sello" />
                <span>{limite}</span>
              </li>
            ))
          }
        </ul>
      </section>
      <section
        aria-labelledby="titulo-asistente"
        class="flex flex-col gap-3.5 rounded-3xl bg-tinta p-tarjeta text-white"
      >
        <h2 id="titulo-asistente" class="text-xl font-bold">Pregúntaselo a tu asistente, con tu caso</h2>
        <p class="text-[15px] leading-[1.6] text-sobre-oscuro">
          Con kitlegal instalado, tu asistente de IA lee estos artículos en el BOE en el momento en que preguntas y te
          responde con la cita. Por ejemplo:
        </p>
        <p class="rounded-[16px_16px_16px_4px] bg-oscuro-2 px-[18px] py-3.5 text-base leading-[1.5] font-medium">
          «{consulta.ejemplo}»
        </p>
        <a
          href="/instalar/"
          class="tocable mt-auto inline-flex min-h-11 items-center self-start rounded-full bg-white px-[22px] py-[13px] text-[15px] font-semibold text-tinta"
        >
          Instalar kitlegal, paso a paso
        </a>
      </section>
    </div>

    <nav aria-labelledby="titulo-otras" class:list={[columna, "flex flex-col gap-4 pt-seccion-1"]}>
      <h2 id="titulo-otras" class="text-xl font-bold">Otras consultas</h2>
      <ul class="grid grid-cols-[repeat(auto-fill,minmax(min(280px,100%),1fr))] gap-3">
        {
          otras.map(({ slug, etiqueta, pregunta: otra }) => (
            <li class="flex">
              <a
                href={`/consultas/${slug}/`}
                class="flex w-full flex-col gap-1.5 rounded-[18px] border border-linea bg-white px-5 py-[18px] transition-colors hover:border-linea-hover"
              >
                <span class="text-[13px] font-semibold text-tenue">{etiqueta}</span>
                <span class="text-base leading-[1.35] font-semibold">{otra}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </article>
</Base>
