---
import "@fontsource-variable/figtree";
// Con el eje de tamaño óptico: los titulares grandes se dibujan más ceñidos.
import "@fontsource-variable/bricolage-grotesque/opsz.css";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";

import figtreeLatin from "@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url";
import bricolageLatin from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url";

import Cabecera from "../components/Cabecera.astro";
import Pie from "../components/Pie.astro";
import { SITIO } from "../lib/proyecto";

interface Props {
  // Título de la pestaña y de los resultados de búsqueda (≤ 60 caracteres).
  titulo: string;
  // Descripción de los resultados de búsqueda (≤ 160 caracteres).
  descripcion: string;
  // Nombre de la imagen de /og/<imagen>.png que acompaña a la página al compartirla.
  imagen: string;
  // Datos estructurados (schema.org) propios de la página.
  datos?: Record<string, unknown>[];
  inicio?: string;
  indexable?: boolean;
}

const { titulo, descripcion, imagen, datos = [], inicio, indexable = true } = Astro.props;

if (titulo.length > 60) throw new Error(`Base: el título «${titulo}» pasa de 60 caracteres`);
if (descripcion.length > 160) throw new Error(`Base: la descripción de «${titulo}» pasa de 160 caracteres`);

const canonica = new URL(Astro.url.pathname, SITIO).href;
const urlImagen = new URL(`/og/${imagen}.png`, SITIO).href;

const sitioWeb = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "kitlegal",
  url: `${SITIO}/`,
  inLanguage: "es-ES",
};

// Todo lo de la página es del propio sitio: ni scripts, ni estilos en línea, ni
// fuentes o imágenes de terceros. GitHub Pages no deja fijar cabeceras, así que
// la política va en un meta. En desarrollo (`make web-dev`) Astro sirve los
// estilos en línea y los recarga con scripts y un WebSocket: ahí se admiten,
// o la página sale sin diseño. Lo que se publica es siempre la política
// estricta.
const politica = [
  "default-src 'self'",
  import.meta.env.DEV ? "script-src 'self' 'unsafe-inline'" : "script-src 'none'",
  import.meta.env.DEV ? "style-src 'self' 'unsafe-inline'" : "style-src 'self'",
  ...(import.meta.env.DEV ? ["connect-src 'self' ws: wss:"] : []),
  "img-src 'self' data:",
  "font-src 'self'",
  "base-uri 'self'",
  "form-action 'none'",
].join("; ");
---

<!doctype html>
<html lang="es-ES">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={politica} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="describedby" href="/llms.txt" />
    {!indexable && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f7f8fb" />

    <link rel="preload" href={bricolageLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={figtreeLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="kitlegal" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={urlImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={titulo} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify([sitioWeb, ...datos])} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#contenido"
      class="sr-only z-[60] rounded-full bg-tinta px-4 py-2 text-white focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
    >
      Saltar al contenido
    </a>
    <Cabecera inicio={inicio} />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Pie />
  </body>
</html>
