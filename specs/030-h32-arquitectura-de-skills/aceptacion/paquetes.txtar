-- filas.awk --
# filas.awk <tabla>... <referencia>: por cada fila de datos de cada tabla, si una
# línea de la referencia —el último fichero— lleva todos sus datos, y cuáles no.
function partir(s, separador, partes,   n, p) {
	n = 0
	while ((p = index(s, separador)) > 0) {
		partes[++n] = substr(s, 1, p - 1)
		s = substr(s, p + length(separador))
	}
	partes[++n] = s
	return n
}
function pide(r, texto) { if (texto != "") necesita[r, ++cuantos[r]] = texto }
function datos(r, linea,   celdas, k, i, preceptos, m, j, p, apartado, cita) {
	sub(/^\| /, "", linea); sub(/ \|$/, "", linea)
	k = partir(linea, " | ", celdas)
	for (i = 1; i <= k; i++) {
		if (celdas[i] == "—") continue
		if (!index(celdas[i], "(BOE-A-") || !index(celdas[i], ", bloque ")) { pide(r, celdas[i]); continue }
		m = partir(celdas[i], "; ", preceptos)
		for (j = 1; j <= m; j++) {
			p = index(preceptos[j], " (")
			apartado = substr(preceptos[j], 1, p - 1)
			cita = substr(preceptos[j], p + 2); sub(/\)$/, "", cita)
			pide(r, apartado)
			pide(r, "[" cita "]")
		}
	}
}
function todos(r, linea,   i) {
	for (i = 1; i <= cuantos[r]; i++) if (!index(linea, necesita[r, i])) return 0
	return 1
}
FNR == 1 { enTabla = 0; referencia = (FILENAME == ARGV[ARGC - 1]) }
referencia { for (r = 1; r <= filas; r++) if (!hallada[r] && todos(r, $0)) hallada[r] = 1; next }
!/^\|/ { next }
!enTabla { enTabla = 1; next }
/^\|[-|]+$/ { next }
{ filas++; fila[filas] = FILENAME ": " $0; datos(filas, $0) }
END {
	estan = 0
	for (r = 1; r <= filas; r++) if (hallada[r]) estan++; else print "sin sus datos: " fila[r]
	print "filas: " estan " de " filas
}
-- iguales.awk --
# iguales.awk <esperadas> <fichero>: cada línea de <esperadas> es, byte a byte,
# una línea de <fichero>.
FNR == 1 { f++ }
f == 1 { esperadas[++n] = $0; next }
{ hay[$0] = 1 }
END {
	estan = 0
	for (i = 1; i <= n; i++) if (esperadas[i] in hay) estan++; else print "falta: " esperadas[i]
	print "iguales: " estan " de " n
}
-- marcas.awk --
# marcas.awk <SKILL.md>: las líneas entre las marcas de los paquetes, sin ellas.
$0 == "<!-- fin de los paquetes -->" { dentro = 0 }
dentro { print }
$0 == "<!-- paquetes: lo genera make skills-sync -->" { dentro = 1 }
-- paquete.awk --
# paquete.awk <data/normas.yaml>: por cada norma con vertical, lo que la nombra
# —«identificador|<id>», «titulo|<título hasta la primera coma>» y
# «abreviatura|<abreviatura>»— y, al final, cuántas normas tienen vertical.
function valor(linea) {
	sub(/^[^:]*:[ \t]*/, "", linea); sub(/[ \t]+$/, "", linea)
	if (linea ~ /^".*"$/ || linea ~ /^'.*'$/) linea = substr(linea, 2, length(linea) - 2)
	return linea
}
function cerrar(   c) {
	if (id != "" && vertical != "") {
		normas++
		print "identificador|" id
		c = index(titulo, ",")
		if (c) titulo = substr(titulo, 1, c - 1)
		if (titulo != "") print "titulo|" titulo
		if (abreviatura != "") print "abreviatura|" abreviatura
	}
	id = ""; titulo = ""; abreviatura = ""; vertical = ""
}
/^  [^ #][^:]*:[ \t]*$/ { cerrar(); id = $0; sub(/^  /, "", id); sub(/:[ \t]*$/, "", id); next }
/^    titulo:/ { titulo = valor($0) }
/^    abreviatura:/ { abreviatura = valor($0) }
/^    vertical:/ { vertical = valor($0) }
END { cerrar(); print "normas con vertical: " normas + 0 }
-- cuerpos.sh --
# cuerpos.sh <skills> <skill>...: el cuerpo del SKILL.md de cada <skill>, desde la
# línea que sigue al --- que cierra el frontmatter, en una línea «<skill>: <texto>»,
# con sus líneas juntadas por un espacio y los blancos colapsados.
raiz=$1
shift
for skill in "$@"; do
	awk -v skill="$skill" '
		d >= 2 { texto = texto " " $0; next }
		$0 == "---" { d++ }
		END { gsub(/[ \t]+/, " ", texto); print skill ":" texto }
	' "$raiz/$skill/SKILL.md"
done
exit 0
-- nombra.awk --
# nombra.awk <términos>... cuerpos.txt: por cada cuerpo de cuerpos.txt —una línea
# «<skill>: <texto>»—, cada término de los ficheros de términos —una línea
# «<clase>|<término>»— que lo nombra: con la clase abreviatura, como palabra
# entera; con las demás, como texto.
function palabra(texto, w,   base, resto, p, antes, despues) {
	base = 0; resto = texto
	while ((p = index(resto, w)) > 0) {
		antes = (base + p > 1) ? substr(texto, base + p - 1, 1) : ""
		despues = substr(texto, base + p + length(w), 1)
		if (antes !~ /[A-Za-z0-9_]/ && despues !~ /[A-Za-z0-9_]/) return 1
		base += p; resto = substr(texto, base + 1)
	}
	return 0
}
FILENAME !~ /cuerpos\.txt$/ {
	if ((c = index($0, "|")) > 0) { n++; clase[n] = substr($0, 1, c - 1); termino[n] = substr($0, c + 1) }
	next
}
{
	cuerpos++
	skill = $0; sub(/: .*/, "", skill)
	texto = substr($0, length(skill) + 3)
	for (i = 1; i <= n; i++) {
		hay = (clase[i] == "abreviatura") ? palabra(texto, termino[i]) : index(texto, termino[i])
		if (hay) { print "nombra " skill ": " termino[i]; nombradas++ }
	}
}
END { print "cuerpos: " cuerpos + 0 "; normas nombradas: " nombradas + 0 }
