# paquetes.txtar
# Lo administrativo es el primer paquete de materia: cada fila de las tres
# referencias generadas de legal-core en c991808 —la cobertura por materia, los
# recursos y plazos y las leyes vertebrales— tiene sus datos en la referencia del
# paquete en plazos-y-territorio, con la cita en la forma única; la fila de la
# aplicación de los tributos es, byte a byte, la del ejemplo de
# contracts/paquetes.md §3; ningún cuerpo de una skill de capacidad nombra una
# norma del paquete ni una de las evals por materia; y el SKILL.md de
# plazos-y-territorio lleva, entre sus marcas, el enlace a la referencia.
#
# Cubre: US4 · FR-019, FR-021, FR-023 · SC-017.
#
# Las tres referencias de c991808 van copiadas enteras en las secciones
# c991808/, tal como las da git show: el make ci de la entrega corre sobre un
# clon superficial, sin ese commit. Una fila tiene sus datos en la referencia si
# una de sus líneas lleva cada celda de la fila tal cual y, de cada precepto
# «<apartado> (<identificador>, bloque <id>)», el apartado y
# «[<identificador>, bloque <id>]» (filas.awk); una celda «—» no tiene datos.
#
# Las normas del paquete son las de data/normas.yaml de la rama con vertical: su
# identificador, su título hasta la primera coma y su abreviatura (paquete.awk).
# Se buscan en el cuerpo de cada SKILL.md de capacidad, desde la línea que sigue
# al --- que cierra el frontmatter y con sus líneas juntadas por un espacio y los
# blancos colapsados: la abreviatura, como palabra entera; lo demás y la lista
# mínima de FR-021, como texto. Los awk y el sh salen siempre con 0: el veredicto
# es el de stdout.

env REFERENCIA=$KITLEGAL_SKILLS/plazos-y-territorio/references/administrativo.md
exists $REFERENCIA

# --- FR-019: cada fila de c991808, con sus datos, en la referencia del paquete ---
exec awk -f filas.awk c991808/cobertura_por_materia.md c991808/recursos_y_plazos.md c991808/leyes_vertebrales.md $REFERENCIA
stdout '^filas: 33 de 33$'

# --- FR-012, FR-019: la fila de la aplicación de los tributos, byte a byte ---
exec awk -f iguales.awk tributos.txt $REFERENCIA
stdout '^iguales: 1 de 1$'

# --- FR-023: el enlace a la referencia, entre las marcas de los paquetes ---
exists $KITLEGAL_SKILLS/plazos-y-territorio/SKILL.md
exec awk -f marcas.awk $KITLEGAL_SKILLS/plazos-y-territorio/SKILL.md
cp stdout entre-marcas.txt
exec awk -f iguales.awk enlace.txt entre-marcas.txt
stdout '^iguales: 1 de 1$'

# --- FR-021: ningún cuerpo de capacidad nombra una norma del paquete ni de la lista mínima ---
exists $KITLEGAL_SKILLS/normativa/SKILL.md
exists $KITLEGAL_SKILLS/jurisprudencia/SKILL.md
exec awk -f paquete.awk $KITLEGAL_SKILLS/../data/normas.yaml
stdout '^normas con vertical: [1-9][0-9]*$'
cp stdout normas-del-paquete.txt
exec sh cuerpos.sh $KITLEGAL_SKILLS normativa jurisprudencia plazos-y-territorio
cp stdout cuerpos.txt
exec awk -f nombra.awk normas-del-paquete.txt lista-minima.txt cuerpos.txt
stdout '^cuerpos: 3; normas nombradas: 0$'

