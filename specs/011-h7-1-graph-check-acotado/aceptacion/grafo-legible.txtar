-- sin-texto.sh --
# sin-texto.sh <sobre> <salida>…: ninguna línea no vacía de 20 caracteres o
# más del texto del bloque que lleva <sobre>, el de boe articulo --json,
# aparece en ninguna de las salidas (H7 FR 070; FR-060, SC-010). Las líneas se
# toman del valor de «texto» que precede a «hash_texto» —el del bloque, y no el
# de ningún aviso, que va detrás—, partido por sus saltos de línea escapados; si
# no hay ninguna, falla, para no pasar en vacío.
set -u
sobre=$1
shift
sed -n 's/^.*"texto":"\(.*\)","hash_texto":.*$/\1/p' "$sobre" |
	awk '{ n = split($0, partes, /\\n/); for (i = 1; i <= n; i++) if (length(partes[i]) >= 20) print partes[i] }' > lineas
test -s lineas || { echo "el sobre no lleva ninguna línea de texto de 20 caracteres o más" >&2; exit 1; }
if grep -F -f lineas "$@" >&2; then
	echo "una línea del texto del bloque aparece en la salida" >&2
	exit 1
fi
