# La lectura sin --fecha no cambia ni un byte. boe articulo BOE-A-1985-5392
# a22, con --json y sin él, da la salida de main y ninguna en la de error; el 3
# de un bloque que no está en la norma (a9999) y el 2 de una norma mal formada
# (BOE-A-2015), con --json y sin él, dan su código exacto, el sobre de main en
# la salida estándar con --json, nada en ella sin --json, y el mensaje de main
# en la de error; y boe articulos BOE-A-2015-10565 a21 a22 --describe da el
# documento de main.
#
# Cubre: US3.1 · FR-012, FR-070, FR-083 · SC-005.
#
# Las secciones main-* son la salida del binario del arnés en la cabeza de la
# rama del hito antes de su código (beed7f7), con el reloj T0 y sobre lo grabado
# de H4 en reproduccion/, capturadas una por una con una copia momentánea de
# este guion en el directorio de guiones de internal/app (research D20). El
# kernel fecha el sobre de un 2 con su reloj, también en el binario T0: ese sobre
# se compara con su fecha de consulta igualada por sed en los dos lados
# (research S3). La salida de error de un fallo lleva delante la línea del
# registro de eventos, con el instante y la duración de la invocación, que no
# es la salida del verbo: se compara el mensaje, sin las líneas que empiezan por
# time=. Como en boe-codigos.txtar, el código exacto lo comprueba el intérprete
# de órdenes.

# Precondición: boe articulo admite --fecha (FR-001).
exec kitlegal boe articulo --help
stdout '--fecha'

# --- La lectura de hoy, con --json y sin él (FR-012, FR-083) ---
exec $KITLEGAL_T0_BIN boe articulo BOE-A-1985-5392 a22 --json
! stderr .
cmp stdout main-a22.json

exec $KITLEGAL_T0_BIN boe articulo BOE-A-1985-5392 a22
! stderr .
cmp stdout main-a22.txt

# --- El 3 de un bloque que no está en la norma (FR-012, FR-083) ---
exec sh -c '$KITLEGAL_T0_BIN boe articulo BOE-A-2015-10565 a9999 --json; test $? -eq 3'
cmp stdout main-a9999.json
cp stderr a9999-json.err
exec sed '/^time=/d' a9999-json.err
cmp stdout main-a9999.mensaje

exec sh -c '$KITLEGAL_T0_BIN boe articulo BOE-A-2015-10565 a9999; test $? -eq 3'
! stdout .
cp stderr a9999.err
exec sed '/^time=/d' a9999.err
cmp stdout main-a9999.mensaje

# --- El 2 de una norma mal formada (FR-012, FR-083) ---
exec sh -c '$KITLEGAL_T0_BIN boe articulo BOE-A-2015 a21 --json; test $? -eq 2'
cp stdout norma.json
cp stderr norma-json.err
exec sed 's/"fecha_consulta":"[^"]*"/"fecha_consulta":""/' main-norma.json
cp stdout main-norma.sin-fecha
exec sed 's/"fecha_consulta":"[^"]*"/"fecha_consulta":""/' norma.json
cmp stdout main-norma.sin-fecha
exec sed '/^time=/d' norma-json.err
cmp stdout main-norma.mensaje

exec sh -c '$KITLEGAL_T0_BIN boe articulo BOE-A-2015 a21; test $? -eq 2'
! stdout .
cp stderr norma.err
exec sed '/^time=/d' norma.err
cmp stdout main-norma.mensaje

# --- boe articulos no cambia: su --describe es el de main (FR-070) ---
exec $KITLEGAL_T0_BIN boe articulos BOE-A-2015-10565 a21 a22 --describe
! stderr .
cmp stdout main-articulos.describe

