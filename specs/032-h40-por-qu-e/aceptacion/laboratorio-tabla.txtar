# laboratorio-tabla.txtar
# La tabla de un sondeo con `laboratorio tabla`, el programa que lanza la
# persona, sin red, modelo ni credencial (contracts/arnes-e2e.md §2;
# contracts/tabla.md §1 a §4; research D13). Sobre las sesiones fijas de H39 de
# `main`, con la declaración y la tabla esperada de `main`, la salida es esa
# tabla, byte a byte: si el hito cambiara esas sesiones, esa tabla o los tests
# de H39, este guion, congelado, seguiría comparando con las de `main`. Sobre
# cinco sesiones fijas de las variantes de normativa, la tabla de la familia y
# su detalle, byte a byte: una referencia abierta dos veces, por tramos, y otra
# que ninguna sesión abre; `Skill` y la primera herramienta en el mismo turno;
# una sesión sin terminar y una fila sin ninguna sesión terminada; una sesión
# que cumple la regla testigo y otra que no; las columnas de la familia y la
# celda vacía de la regla fuera de normativa-testigo-en-referencia.
#
# Cubre: US3.1, US3.2, US3.3, US3.4 · FR-020, FR-021, FR-023, FR-030 · SC-005, SC-007; los extremos de Wilson de 0, 20 y 40 de 40 los comprueba TestTablaDeNormativa
#
# La orden tabla lee la declaración del laboratorio de H39 del directorio en que
# se ejecuta, que en un guion es $WORK: por eso laboratorio/variantes.yaml va en
# el archivo. El programa no va en el PATH: el arnés da su ruta absoluta en
# KITLEGAL_LABORATORIO_BIN (contracts/arnes-e2e.md §1).

# --- La tabla de H39, la de main, sin cambiar una cifra ni una columna ---
exec $KITLEGAL_LABORATORIO_BIN tabla h39
cmp stdout h39-tabla.md
! stderr .

# --- La tabla de las variantes de normativa y su detalle ---
# La primera invocación, a través del intérprete de órdenes, no hace fallar el
# guion por su código: mientras la tabla no conozca la familia, el guion falla en
# la comparación de lo que escribe con la tabla esperada. La segunda exige el
# código 0, la misma tabla y la salida de error vacía.
exec sh -c '"$KITLEGAL_LABORATORIO_BIN" tabla normativa > tabla-normativa.out || true'
cmp tabla-normativa.out normativa-tabla.md
exec $KITLEGAL_LABORATORIO_BIN tabla normativa
cmp stdout normativa-tabla.md
! stderr .

-- laboratorio/variantes.yaml --
# Variantes de la skill de laboratorio de H39: la de control y siete que difieren de ella en las partes que declaran
# (specs/031-h39-c-omo-se/data-model.md §2 y §3). Lo comprueba TestVariantesDelLaboratorio.
skill: articulos-del-boe
entrada: consulta-legal
herramienta: boe_articulo
parametro: bloque
referencia: cierre.md
variantes:
  - {nombre: control, modos: [orden, herramienta], cambia: []}
  - {nombre: instrucciones, modos: [herramienta], cambia: [instrucciones]}
  - {nombre: entrada, modos: [orden, herramienta], cambia: [entrada]}
  - {nombre: referencia-secundaria, modos: [orden, herramienta], cambia: [cuerpo, referencia]}
  - {nombre: parametro, modos: [herramienta], cambia: [cuerpo, parametro]}
  - {nombre: referencia-paso, modos: [orden, herramienta], cambia: [cuerpo, referencia]}
  - {nombre: referencia-en-el-punto, modos: [orden, herramienta], cambia: [cuerpo, referencia]}
  - {nombre: descripcion-sin-herramientas, modos: [orden, herramienta], cambia: [descripcion]}
