3 boe_articulo resultado
4 boe_articulos resultado
5 boe_metadatos resultado
6 boe_analisis resultado
7 territorio_resolver resultado
8 territorio_resolver resultado
salida 0
-- grafo.txt --
graph_show {"id":"eli/es/l/2015/10/01/39#a21"}
graph_stats {}
graph_check {"norma":"BOE-A-2015-10565","bloques":["a21"]}
-- grafo.salida --
protocolo 2026-07-28
capacidades tools
1 graph_show resultado
2 graph_stats resultado
3 graph_check resultado
salida 0
