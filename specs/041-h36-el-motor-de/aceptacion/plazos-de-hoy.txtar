# plazos-de-hoy.txtar
# Con los datos de hoy, lo único que ve quien usa el binario es que la
# herramienta ya no nombra los tipos: ni la ayuda del tipo ni el esquema de la
# salida de --describe dicen alzada ni reposicion (spec §C.7 y §C.8). Todo lo
# demás sale como en main: el sobre de los casos 11, 15 y 16 y el de cada error
# de §C.6, incluidos los dos de municipios que no cuentan, es byte a byte el que
# da el binario de main, salvo fecha_consulta, con su mismo código.
#
# Cubre: US1 · FR-005, FR-006, FR-008, FR-011, FR-012, FR-021 · SC-001
#
# Los ficheros de detrás del guion son los sobres capturados con el binario de
# main (cd3ad148) antes de cualquier cambio de producto, con fecha_consulta
# vaciado (contracts/aceptacion.md §1). Cada orden escribe su sobre en
# sobre.json, lo pasa por la misma sustitución de la captura y comprueba con
# test, dentro de sh, el código de kitlegal y no el de sed. La salida de error
# del binario no entra en la comparación. La fila «no cargan» de §C.6 y la nueva
# de FR-007 no se capturan: main no puede darlas (§2.3).

# --- Lo que falla hoy: la herramienta ya no nombra los tipos (§C.7, §C.8) ---
exec kitlegal plazos calcular x x x --describe
! stdout 'alzada'
! stdout 'reposicion'

# --- Los tres casos, como en main (US1.2) ---
exec sh -c 'kitlegal plazos calcular silencio 2026-07-09 Leganés Leganés --duracion 3 --unidad meses --json >sobre.json; c=$?; sed -E ''s/"fecha_consulta":"[^"]*"/"fecha_consulta":""/'' sobre.json; test $c -eq 0'
cmp stdout caso-11.json

exec sh -c 'kitlegal plazos calcular contencioso 2026-10-27 Madrid --json >sobre.json; c=$?; sed -E ''s/"fecha_consulta":"[^"]*"/"fecha_consulta":""/'' sobre.json; test $c -eq 0'
cmp stdout caso-15.json

exec sh -c 'kitlegal plazos calcular contencioso 2026-10-31 Madrid --json >sobre.json; c=$?; sed -E ''s/"fecha_consulta":"[^"]*"/"fecha_consulta":""/'' sobre.json; test $c -eq 0'
cmp stdout caso-16.json

# --- Los errores de §C.6, como en main, con su código (US1.3) ---
exec sh -c 'kitlegal plazos calcular inventado 2026-09-09 Leganés Leganés --json >sobre.json; c=$?; sed -E ''s/"fecha_consulta":"[^"]*"/"fecha_consulta":""/'' sobre.json; test $c -eq 2'
cmp stdout error-tipo.json

exec sh -c 'kitlegal plazos calcular reposicion 2026-02-30 Leganés Leganés --json >sobre.json; c=$?; sed -E ''s/"fecha_consulta":"[^"]*"/"fecha_consulta":""/'' sobre.json; test $c -eq 2'
cmp stdout error-inicio.json

exec sh -c 'kitlegal plazos calcular generico 2026-09-09 Leganés Leganés --unidad dias-habiles --json >sobre.json; c=$?; sed -E ''s/"fecha_consulta":"[^"]*"/"fecha_consulta":""/'' sobre.json; test $c -eq 2'
cmp stdout error-duracion.json

exec sh -c 'kitlegal plazos calcular generico 2026-09-09 Leganés Leganés --duracion 3 --unidad semanas --json >sobre.json; c=$?; sed -E ''s/"fecha_consulta":"[^"]*"/"fecha_consulta":""/'' sobre.json; test $c -eq 2'
cmp stdout error-unidad.json

exec sh -c 'kitlegal plazos calcular reposicion 2026-09-09 Leganés --json >sobre.json; c=$?; sed -E ''s/"fecha_consulta":"[^"]*"/"fecha_consulta":""/'' sobre.json; test $c -eq 2'
cmp stdout error-municipios-lpac.json

exec sh -c 'kitlegal plazos calcular contencioso 2026-06-15 Madrid Leganés --json >sobre.json; c=$?; sed -E ''s/"fecha_consulta":"[^"]*"/"fecha_consulta":""/'' sobre.json; test $c -eq 2'
cmp stdout error-municipios-contencioso.json

exec sh -c 'kitlegal plazos calcular reposicion 2026-09-09 Arroyomolinos Leganés --json >sobre.json; c=$?; sed -E ''s/"fecha_consulta":"[^"]*"/"fecha_consulta":""/'' sobre.json; test $c -eq 2'
cmp stdout error-ambiguo.json

exec sh -c 'kitlegal plazos calcular reposicion 2026-09-09 Inexistente Leganés --json >sobre.json; c=$?; sed -E ''s/"fecha_consulta":"[^"]*"/"fecha_consulta":""/'' sobre.json; test $c -eq 3'
cmp stdout error-inexistente.json

exec sh -c 'kitlegal plazos calcular generico 9999-12-31 Leganés Leganés --duracion 1 --unidad dias-naturales --json >sobre.json; c=$?; sed -E ''s/"fecha_consulta":"[^"]*"/"fecha_consulta":""/'' sobre.json; test $c -eq 2'
cmp stdout error-fuera-del-calendario.json

-- caso-11.json --
