# graph check avisa de que una consulta ha caducado: sin world.db no hay nada
# que comprobar y no lo crea; un bloque consultado con el reloj T0 no ha
# caducado con T1 y sí con T8, y entonces da un hallazgo fuente-caducada en la
# Norma, en el Bloque y en el BloqueVersion, cada uno con la vigencia en
# segundos y una explicación con la fuente, la url y la fecha_consulta de la
# observación, la vigencia y el instante en que caducó; ninguno en el Municipio
# ni en el Organo, que no declaran vigencia; y una lectura nueva lo renueva.
#
# Cubre: US2.4, US2.5 · FR-004, FR-023, FR-061, FR-065, FR-066, FR-067.
#
# La vigencia de boe articulo es la de su caché, 604800 s (FR-065); T0, T1 y
# T8 son los relojes de contracts/arnes-e2e.md §2 (2026-09-28T12:00:00Z,
# 2026-09-29T12:00:00Z y 2026-10-06T12:00:00Z), así que la consulta de T0 caducó
# el 2026-10-05T12:00:00Z; la plantilla, la cita de cada tipo de nodo y el
# orden (por clase y después por id), de contracts/applet-graph.md §3.3 y §5 y
# data-model §6.

# Precondición: el binario registra el applet graph (FR-050).
exec kitlegal --help
stdout '^  graph +\S'

# --- Sin world.db: nada que comprobar, y sigue sin existir (US2.5, FR-004) ---
! exists cache
exec $KITLEGAL_T8_BIN graph check --json
stdout '\A\{"ok":true,"fuente":"kitlegal\.graph","url":"kitlegal:applet/graph","fecha_consulta":"2026-10-06T12:00:00Z","hash":"sha256:[0-9a-f]{64}","data":\[\]\}\n\z'
! stderr .
! exists cache

# --- Un bloque consultado con T0 y un municipio ---
exec $KITLEGAL_T0_BIN boe articulo BOE-A-2015-10565 a21 --json
stdout '\A\{"ok":true,"fuente":"boe\.legislacion-consolidada","url":"https://www\.boe\.es/datosabiertos/api/legislacion-consolidada/id/BOE-A-2015-10565/texto/bloque/a21","fecha_consulta":"2026-09-28T12:00:00Z",'
! stderr .
exec $KITLEGAL_T0_BIN territorio resolver Leganés --json
! stderr .

# --- Dentro de la vigencia: ningún hallazgo con T1 ---
exec $KITLEGAL_T1_BIN graph check --json
stdout '\A\{"ok":true,"fuente":"kitlegal\.graph","url":"kitlegal:applet/graph","fecha_consulta":"2026-09-29T12:00:00Z","hash":"sha256:[0-9a-f]{64}","data":\[\]\}\n\z'
! stderr .

# --- Caducada con T8 (US2.4, FR-066) ---
#
# Código 0 y tres hallazgos fuente-caducada, ordenados por id: la Norma, citada
# por su identificador; el Bloque y el BloqueVersion, por la cita del bloque.
exec $KITLEGAL_T8_BIN graph check --json
stdout '\A\{"ok":true,"fuente":"kitlegal\.graph","url":"kitlegal:applet/graph","fecha_consulta":"2026-10-06T12:00:00Z","hash":"sha256:[0-9a-f]{64}","data":\[\{"clase":"fuente-caducada","id":"eli/es/l/2015/10/01/39","explicacion":"La consulta de BOE-A-2015-10565 a boe\.legislacion-consolidada en https://www\.boe\.es/datosabiertos/api/legislacion-consolidada/id/BOE-A-2015-10565/texto/bloque/a21 del 2026-09-28T12:00:00Z tenía una vigencia de 604800 s y caducó el 2026-10-05T12:00:00Z\.","procedencia":\{"fuente":"boe\.legislacion-consolidada","url":"https://www\.boe\.es/datosabiertos/api/legislacion-consolidada/id/BOE-A-2015-10565/texto/bloque/a21","fecha_consulta":"2026-09-28T12:00:00Z"\},"vigencia_segundos":604800\},\{"clase":"fuente-caducada","id":"eli/es/l/2015/10/01/39#a21","explicacion":"La consulta de \[BOE-A-2015-10565, bloque a21\] a boe\.legislacion-consolidada en https://www\.boe\.es/datosabiertos/api/legislacion-consolidada/id/BOE-A-2015-10565/texto/bloque/a21 del 2026-09-28T12:00:00Z tenía una vigencia de 604800 s y caducó el 2026-10-05T12:00:00Z\.","procedencia":\{"fuente":"boe\.legislacion-consolidada","url":"https://www\.boe\.es/datosabiertos/api/legislacion-consolidada/id/BOE-A-2015-10565/texto/bloque/a21","fecha_consulta":"2026-09-28T12:00:00Z"\},"vigencia_segundos":604800\},\{"clase":"fuente-caducada","id":"eli/es/l/2015/10/01/39#a21@20161002:sha256:98d3b9d4686a3155f48641841df7023e2c17a693fcd0e11d6beef2615abcec7c","explicacion":"La consulta de \[BOE-A-2015-10565, bloque a21\] a boe\.legislacion-consolidada en https://www\.boe\.es/datosabiertos/api/legislacion-consolidada/id/BOE-A-2015-10565/texto/bloque/a21 del 2026-09-28T12:00:00Z tenía una vigencia de 604800 s y caducó el 2026-10-05T12:00:00Z\.","procedencia":\{"fuente":"boe\.legislacion-consolidada","url":"https://www\.boe\.es/datosabiertos/api/legislacion-consolidada/id/BOE-A-2015-10565/texto/bloque/a21","fecha_consulta":"2026-09-28T12:00:00Z"\},"vigencia_segundos":604800\}\]\}\n\z'
! stderr .

# Ninguno en el Municipio ni en el Organo, que no declaran vigencia, ni
# ninguna version-obsoleta, con una sola versión observada.
! stdout '"id":"ine:28074"'
! stdout '"id":"L01280745"'
! stdout 'version-obsoleta'

# --- Una lectura nueva renueva la consulta ---
#
# Sin cache.db, boe vuelve a pedir el bloque con el reloj T8: la misma versión,
# con su primera observación de T0 y la última de T8, y ya nada ha caducado
# (FR-023, FR-066).
rm cache/cache.db
exec $KITLEGAL_T8_BIN boe articulo BOE-A-2015-10565 a21 --json
stdout '"fecha_consulta":"2026-10-06T12:00:00Z"'
stdout '"hash_texto":"sha256:98d3b9d4686a3155f48641841df7023e2c17a693fcd0e11d6beef2615abcec7c"'
! stderr .

exec $KITLEGAL_T8_BIN graph check --json
stdout '\A\{"ok":true,"fuente":"kitlegal\.graph","url":"kitlegal:applet/graph","fecha_consulta":"2026-10-06T12:00:00Z","hash":"sha256:[0-9a-f]{64}","data":\[\]\}\n\z'
! stderr .

exec $KITLEGAL_T8_BIN graph show 'eli/es/l/2015/10/01/39#a21@20161002:sha256:98d3b9d4686a3155f48641841df7023e2c17a693fcd0e11d6beef2615abcec7c' --json
stdout '"nodo":\{"id":"eli/es/l/2015/10/01/39#a21@20161002:sha256:98d3b9d4686a3155f48641841df7023e2c17a693fcd0e11d6beef2615abcec7c","tipo":"BloqueVersion","datos":\{[^{}]*\},"primera_observacion":"2026-09-28T12:00:00Z","ultima_observacion":\{"fuente":"boe\.legislacion-consolidada","url":"https://www\.boe\.es/datosabiertos/api/legislacion-consolidada/id/BOE-A-2015-10565/texto/bloque/a21","fecha_consulta":"2026-10-06T12:00:00Z"\}\}'
! stderr .
