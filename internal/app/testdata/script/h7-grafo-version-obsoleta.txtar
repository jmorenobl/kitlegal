# graph check avisa de que una redacción ya consultada ha cambiado: un bloque
# consultado con la grabación de H4 (A) y, con la caché renovada y el mismo
# world.db, con la derivada de fecha_vigencia posterior (B) da exactamente un
# hallazgo version-obsoleta, sobre la versión de A, con su explicación citable y
# código 0; y con una sola versión, ninguno.
#
# Cubre: US2.1, US2.2 · FR-060, FR-061, FR-062, FR-063, FR-064, FR-090,
# FR-093 · SC-005.
#
# A es la grabación de H4 (fecha_vigencia 20161002 y el hash_texto de su sobre)
# y B, la derivada version-posterior de contracts/arnes-e2e.md §3
# (fecha_vigencia 20250101). La huella de B no se fija aquí: solo se afirma que
# es otra. Las fechas son las de los relojes T0 (2026-09-28T12:00:00Z) y T1
# (2026-09-29T12:00:00Z) de contracts/arnes-e2e.md §2; la plantilla de la
# explicación y las claves del hallazgo, las de contracts/applet-graph.md §3.3 y
# §5.

# Precondición: el binario registra el applet graph (FR-050).
exec kitlegal --help
stdout '^  graph +\S'

# --- A, la grabación de H4, con el reloj T0 ---
exec $KITLEGAL_T0_BIN boe articulo BOE-A-2015-10565 a21 --json
stdout '\A\{"ok":true,"fuente":"boe\.legislacion-consolidada","url":"https://www\.boe\.es/datosabiertos/api/legislacion-consolidada/id/BOE-A-2015-10565/texto/bloque/a21","fecha_consulta":"2026-09-28T12:00:00Z",'
stdout '"fecha_vigencia":"20161002"'
stdout '"hash_texto":"sha256:98d3b9d4686a3155f48641841df7023e2c17a693fcd0e11d6beef2615abcec7c"'
! stderr .

# --- Una sola versión observada: ningún hallazgo (US2.2) ---
exec $KITLEGAL_T1_BIN graph check --json
stdout '\A\{"ok":true,"fuente":"kitlegal\.graph","url":"kitlegal:applet/graph","fecha_consulta":"2026-09-29T12:00:00Z","hash":"sha256:[0-9a-f]{64}","data":\{"norma":"","bloques":\[\],"version-obsoleta":0,"fuente-caducada":0,"omitidos":0,"hallazgos":\[\]\}\}\n\z'
! stderr .

# --- B, la derivada, con la caché renovada y el mismo world.db (US2.1) ---
#
# La derivada ocupa el nombre de la grabación de A en la reproducción y, sin
# cache.db, boe la pide de nuevo.
cp derivadas/version-posterior/GET_https_www.boe.es_datosabiertos_api_legislacion-consolidada_id_BOE-A-2015-10565_texto_bloque_a21.json reproduccion/boe.legislacion-consolidada/
rm cache/cache.db
exists cache/world.db

exec $KITLEGAL_T1_BIN boe articulo BOE-A-2015-10565 a21 --json
stdout '\A\{"ok":true,"fuente":"boe\.legislacion-consolidada","url":"https://www\.boe\.es/datosabiertos/api/legislacion-consolidada/id/BOE-A-2015-10565/texto/bloque/a21","fecha_consulta":"2026-09-29T12:00:00Z",'
stdout '"fecha_vigencia":"20250101"'
stdout '"hash_texto":"sha256:[0-9a-f]{64}"'
! stdout '"hash_texto":"sha256:98d3b9d4686a3155f48641841df7023e2c17a693fcd0e11d6beef2615abcec7c"'
! stderr .

# Código 0, ok true y exactamente un hallazgo: version-obsoleta sobre el
# BloqueVersion de A, con la cita del bloque, las dos fecha_vigencia tal como
# las traen los sobres, y la url y la fecha_consulta del sobre de B (FR-063,
# SC-005). Con T1 ninguna consulta ha caducado todavía.
exec $KITLEGAL_T1_BIN graph check --json
stdout '\A\{"ok":true,"fuente":"kitlegal\.graph","url":"kitlegal:applet/graph","fecha_consulta":"2026-09-29T12:00:00Z","hash":"sha256:[0-9a-f]{64}","data":\{"norma":"","bloques":\[\],"version-obsoleta":1,"fuente-caducada":0,"omitidos":0,"hallazgos":\[\{"clase":"version-obsoleta","id":"eli/es/l/2015/10/01/39#a21@20161002:sha256:98d3b9d4686a3155f48641841df7023e2c17a693fcd0e11d6beef2615abcec7c","explicacion":"La versión de \[BOE-A-2015-10565, bloque a21\] con fecha de vigencia 20161002 está superada por la de fecha de vigencia 20250101, observada en https://www\.boe\.es/datosabiertos/api/legislacion-consolidada/id/BOE-A-2015-10565/texto/bloque/a21 el 2026-09-29T12:00:00Z\.","procedencia":\{"fuente":"boe\.legislacion-consolidada","url":"https://www\.boe\.es/datosabiertos/api/legislacion-consolidada/id/BOE-A-2015-10565/texto/bloque/a21","fecha_consulta":"2026-09-29T12:00:00Z"\},"fecha_vigencia":"20161002","fecha_vigencia_reciente":"20250101"\}\]\}\}\n\z'
! stderr .
cp stdout obsoleta.json

# Comprobar no cambia nada: la misma lista en una segunda ejecución con el mismo
# instante (FR-062).
exec $KITLEGAL_T1_BIN graph check --json
cmp stdout obsoleta.json

# Las dos versiones son dos nodos del mismo Bloque, cada una con la procedencia
# de su propia consulta; los textos, uno por huella.
exec $KITLEGAL_T1_BIN graph show 'eli/es/l/2015/10/01/39#a21' --json
stdout '"salientes":\[\{"relacion":"eli:has_version","id":"eli/es/l/2015/10/01/39#a21@20161002:sha256:98d3b9d4686a3155f48641841df7023e2c17a693fcd0e11d6beef2615abcec7c","primera_observacion":"2026-09-28T12:00:00Z","ultima_observacion":\{"fuente":"boe\.legislacion-consolidada","url":"https://www\.boe\.es/datosabiertos/api/legislacion-consolidada/id/BOE-A-2015-10565/texto/bloque/a21","fecha_consulta":"2026-09-28T12:00:00Z"\}\},\{"relacion":"eli:has_version","id":"eli/es/l/2015/10/01/39#a21@20250101:sha256:[0-9a-f]{64}","primera_observacion":"2026-09-29T12:00:00Z","ultima_observacion":\{"fuente":"boe\.legislacion-consolidada","url":"https://www\.boe\.es/datosabiertos/api/legislacion-consolidada/id/BOE-A-2015-10565/texto/bloque/a21","fecha_consulta":"2026-09-29T12:00:00Z"\}\}\]'
! stderr .
exec $KITLEGAL_T1_BIN graph stats --json
stdout '"data":\{"nodos":4,"aristas":3,"textos":2,'
! stderr .
