# Los códigos de los tres verbos de graph: 0 con el grafo ausente, vacío o
# poblado; 3 cuando show no encuentra el id; 2 con argumentos de más o de
# menos, con un id vacío, formado solo por espacio en blanco o con un carácter
# de control, y con una ubicación de la caché que no da un directorio, con y
# sin --no-graph; y 1 con un world.db que no es una base de datos. Un world.db
# de 0 bytes se lee como un grafo vacío sin modificarlo, y la primera entrega
# crea en él el esquema sin aviso.
#
# Cubre: US4.3, US4.4, US6.4 · FR-004, FR-010, FR-011, FR-013, FR-031, FR-052,
# FR-054, FR-060, FR-094 · SC-011.
#
# Los códigos y sus clases son los de contracts/applet-graph.md §4, y los
# mensajes que nombran world.db, los de contracts/almacen-world-db.md §6. Los
# códigos distintos de cero los comprueba el intérprete de órdenes, como en
# boe-codigos.txtar. Los caracteres que no son ASCII del id van literales dentro
# de las comillas de sh -c (testscript solo parte las palabras por el espacio
# ASCII, el tabulador, \r y #; research V40): U+00A0 y U+2003 (espacio en
# blanco), U+0085 (espacio en blanco y control) y U+200B (ninguna de las dos).
# El tabulador y U+007F, que son ASCII, los escribe printf. U+0000 no puede
# viajar en un argumento: lo fija TestValidarID.

# Precondición: el binario registra el applet graph (FR-050).
exec kitlegal --help
stdout '^  graph +\S'

# --- Sin world.db: 0, y 3 en show, sin crear nada (FR-004, FR-053, FR-054, FR-060) ---
! exists cache
exec kitlegal graph stats --json
stdout '\A\{"ok":true,"fuente":"kitlegal\.graph","url":"kitlegal:applet/graph","fecha_consulta":"[^"]+","hash":"sha256:[0-9a-f]{64}","data":\{"nodos":0,"aristas":0,"textos":0,"nodos_por_tipo":\[\],"aristas_por_relacion":\[\]\}\}\n\z'
! stderr .
exec kitlegal graph check --json
stdout '\A\{"ok":true,"fuente":"kitlegal\.graph","url":"kitlegal:applet/graph","fecha_consulta":"[^"]+","hash":"sha256:[0-9a-f]{64}","data":\{"norma":"","bloques":\[\],"version-obsoleta":0,"fuente-caducada":0,"omitidos":0,"hallazgos":\[\]\}\}\n\z'
! stderr .
exec sh -c 'kitlegal graph show ine:28074 --json; test $? -eq 3'
stdout '\A\{"ok":false,.*"data":\{"clase":"no-encontrado","mensaje":"[^\n]*ine:28074[^\n]*"\}\}\n\z'
stderr 'ine:28074'
! exists cache

# --- Con el grafo poblado: 0 y 3 (US4.3) ---
exec kitlegal territorio resolver Leganés --json
! stderr .
[unix] exec cksum cache/world.db
[unix] cp stdout poblado.txt

exec kitlegal graph show ine:28074 --json
stdout '"data":\{"nodo":\{"id":"ine:28074","tipo":"Municipio",'
! stderr .
exec kitlegal graph stats --json
stdout '"data":\{"nodos":2,"aristas":1,"textos":0,'
! stderr .
exec kitlegal graph check --json
stdout '"data":\{"norma":"","bloques":\[\],"version-obsoleta":0,"fuente-caducada":0,"omitidos":0,"hallazgos":\[\]\}\}\n\z'
! stderr .

# Un id que no está: 3, clase no-encontrado, y el mensaje lo nombra.
exec sh -c 'kitlegal graph show ine:99999 --json; test $? -eq 3'
stdout '"data":\{"clase":"no-encontrado","mensaje":"[^\n]*ine:99999[^\n]*"\}\}\n\z'
stderr 'ine:99999'
exec sh -c 'kitlegal graph show "eli/es/l/2015/10/01/39#a21"; test $? -eq 3'
! stdout .
stderr 'eli/es/l/2015/10/01/39#a21'

# Un id con espacio en blanco y algo más no se recorta y se busca tal cual; uno
# con U+200B, que no es espacio en blanco ni control, también: 3 (FR-052).
exec sh -c 'kitlegal graph show "a b" --json; test $? -eq 3'
stdout '"data":\{"clase":"no-encontrado",'
stderr 'a b'
exec sh -c 'kitlegal graph show " ine:28074" --json; test $? -eq 3'
stdout '"data":\{"clase":"no-encontrado",'
exec sh -c 'kitlegal graph show "ine:28074​" --json; test $? -eq 3'
stdout '"data":\{"clase":"no-encontrado",'

# --- Argumentos: 2 (US4.4, FR-052, FR-054, FR-060) ---
#
# show sin id y con dos; stats y check con uno; una bandera desconocida.
exec sh -c 'kitlegal graph show; test $? -eq 2'
! stdout .
stderr 'argumentos inválidos'
exec sh -c 'kitlegal graph show ine:28074 L01280745; test $? -eq 2'
! stdout .
stderr 'argumentos inválidos'
exec sh -c 'kitlegal graph stats ine:28074; test $? -eq 2'
! stdout .
stderr 'argumentos inválidos'
exec sh -c 'kitlegal graph check ine:28074; test $? -eq 2'
! stdout .
stderr 'argumentos inválidos'
exec sh -c 'kitlegal graph stats --no-existe; test $? -eq 2'
! stdout .
stderr 'argumentos inválidos'
exec sh -c 'kitlegal graph check --json ine:28074; test $? -eq 2'
stdout '"data":\{"clase":"argumentos",'

# Un id vacío, uno de solo U+0020, de solo U+00A0, de solo U+2003, de solo un
# tabulador, de solo U+0085 o de solo U+007F: 2 y clase argumentos (FR-052).
exec sh -c 'kitlegal graph show "" --json; test $? -eq 2'
stdout '"data":\{"clase":"argumentos",'
exec sh -c 'kitlegal graph show " " --json; test $? -eq 2'
stdout '"data":\{"clase":"argumentos",'
exec sh -c 'kitlegal graph show " " --json; test $? -eq 2'
stdout '"data":\{"clase":"argumentos",'
exec sh -c 'kitlegal graph show " " --json; test $? -eq 2'
stdout '"data":\{"clase":"argumentos",'
exec sh -c 'kitlegal graph show "$(printf "\t")" --json; test $? -eq 2'
stdout '"data":\{"clase":"argumentos",'
exec sh -c 'kitlegal graph show "" --json; test $? -eq 2'
stdout '"data":\{"clase":"argumentos",'
exec sh -c 'kitlegal graph show "$(printf "\177")" --json; test $? -eq 2'
stdout '"data":\{"clase":"argumentos",'

# Ni los 3 ni los 2 han tocado world.db.
[unix] exec cksum cache/world.db
[unix] cmp stdout poblado.txt

# --- Una ubicación de la caché que no da un directorio: 2, con y sin --no-graph (FR-011, FR-031) ---
#
# KITLEGAL_CACHE_DIR presente y vacía.
env KITLEGAL_CACHE_DIR=
exec sh -c 'kitlegal graph stats --json; test $? -eq 2'
stdout '"data":\{"clase":"argumentos",'
stderr 'grafo: no se puede ubicar world\.db: '
exec sh -c 'kitlegal graph stats --no-graph --json; test $? -eq 2'
stdout '"data":\{"clase":"argumentos",'
stderr 'grafo: no se puede ubicar world\.db: '
exec sh -c 'kitlegal graph check; test $? -eq 2'
exec sh -c 'kitlegal graph check --no-graph; test $? -eq 2'
exec sh -c 'kitlegal graph show ine:28074; test $? -eq 2'
exec sh -c 'kitlegal graph show ine:28074 --no-graph; test $? -eq 2'

# KITLEGAL_CACHE_DIR que nombra un fichero.
env KITLEGAL_CACHE_DIR=$WORK/fichero
exec sh -c 'kitlegal graph stats --json; test $? -eq 2'
stdout '"data":\{"clase":"argumentos",'
stderr 'grafo: no se puede ubicar world\.db: '
exec sh -c 'kitlegal graph stats --no-graph --json; test $? -eq 2'
stdout '"data":\{"clase":"argumentos",'
exec sh -c 'kitlegal graph check; test $? -eq 2'
exec sh -c 'kitlegal graph check --no-graph; test $? -eq 2'
exec sh -c 'kitlegal graph show ine:28074; test $? -eq 2'
exec sh -c 'kitlegal graph show ine:28074 --no-graph; test $? -eq 2'
cmp fichero fichero.original

# Sin KITLEGAL_CACHE_DIR y sin HOME: el mensaje pide declarar una de las dos, y
# no se lee como un grafo ausente.
env KITLEGAL_CACHE_DIR=$WORK/cache
[unix] exec sh -c 'env -u KITLEGAL_CACHE_DIR -u HOME kitlegal graph stats --json; test $? -eq 2'
[unix] stdout '"data":\{"clase":"argumentos",'
[unix] stderr 'grafo: no se puede ubicar world\.db: .*declara HOME o KITLEGAL_CACHE_DIR'
[unix] exec sh -c 'env -u KITLEGAL_CACHE_DIR -u HOME kitlegal graph stats --no-graph --json; test $? -eq 2'
[unix] stderr 'declara HOME o KITLEGAL_CACHE_DIR'
[unix] exec sh -c 'env -u KITLEGAL_CACHE_DIR -u HOME kitlegal graph check; test $? -eq 2'
[unix] exec sh -c 'env -u KITLEGAL_CACHE_DIR -u HOME kitlegal graph check --no-graph; test $? -eq 2'
[unix] exec sh -c 'env -u KITLEGAL_CACHE_DIR -u HOME kitlegal graph show ine:28074; test $? -eq 2'
[unix] exec sh -c 'env -u KITLEGAL_CACHE_DIR -u HOME kitlegal graph show ine:28074 --no-graph; test $? -eq 2'
[unix] exec sh -c 'env -u KITLEGAL_CACHE_DIR HOME= kitlegal graph stats; test $? -eq 2'
[unix] stderr 'declara HOME o KITLEGAL_CACHE_DIR'
[unix] exec sh -c 'env -u KITLEGAL_CACHE_DIR HOME= kitlegal graph stats --no-graph; test $? -eq 2'

# --- world.db que no es una base de datos: 1 en los tres verbos (US6.4, FR-010, SC-011) ---
#
# Clase inesperado y un mensaje que nombra la ruta de world.db.
env KITLEGAL_CACHE_DIR=$WORK/inutil
mkdir inutil
cp no-es-una-base inutil/world.db

exec sh -c 'kitlegal graph stats --json; test $? -eq 1'
stdout '"data":\{"clase":"inesperado","mensaje":"grafo: [^\n]*world\.db[^\n]*"\}\}\n\z'
stderr 'grafo: ".*world\.db" no es una base de datos utilizable'
exec sh -c 'kitlegal graph check --json; test $? -eq 1'
stdout '"data":\{"clase":"inesperado","mensaje":"grafo: [^\n]*world\.db[^\n]*"\}\}\n\z'
stderr 'grafo: ".*world\.db" no es una base de datos utilizable'
exec sh -c 'kitlegal graph show ine:28074 --json; test $? -eq 1'
stdout '"data":\{"clase":"inesperado","mensaje":"grafo: [^\n]*world\.db[^\n]*"\}\}\n\z'
stderr 'grafo: ".*world\.db" no es una base de datos utilizable'
exec sh -c 'kitlegal graph stats --no-graph; test $? -eq 1'

# --- world.db de 0 bytes: un grafo vacío, sin modificarlo (FR-004, FR-013) ---
rm inutil/world.db
cp vacio inutil/world.db
[unix] exec cksum inutil/world.db
[unix] cp stdout vacio.txt

exec kitlegal graph stats --json
stdout '"data":\{"nodos":0,"aristas":0,"textos":0,"nodos_por_tipo":\[\],"aristas_por_relacion":\[\]\}\}\n\z'
! stderr .
exec kitlegal graph check --json
stdout '"data":\{"norma":"","bloques":\[\],"version-obsoleta":0,"fuente-caducada":0,"omitidos":0,"hallazgos":\[\]\}\}\n\z'
! stderr .
exec sh -c 'kitlegal graph show ine:28074 --json; test $? -eq 3'
stdout '"data":\{"clase":"no-encontrado",'
stderr 'ine:28074'

[unix] exec cksum inutil/world.db
[unix] cmp stdout vacio.txt
! exists inutil/world.db-wal
! exists inutil/world.db-shm
! exists inutil/world.db-journal

# La primera entrega crea en él el esquema, sin ninguna línea de grafo en la
# salida de error, y graph stats cuenta lo que entregó (FR-013).
exec kitlegal territorio resolver Leganés --json
! stderr .
exec kitlegal graph stats --json
stdout '"data":\{"nodos":2,"aristas":1,"textos":0,"nodos_por_tipo":\[\{"tipo":"Municipio","fuente":"kitlegal\.territorio","nodos":1\},\{"tipo":"Organo","fuente":"kitlegal\.territorio","nodos":1\}\],"aristas_por_relacion":\[\{"relacion":"lb:pertenece_a","fuente":"kitlegal\.territorio","aristas":1\}\]\}\}\n\z'
! stderr .
exec kitlegal graph show ine:28074 --json
stdout '"data":\{"nodo":\{"id":"ine:28074","tipo":"Municipio",'

-- no-es-una-base --
Este fichero no es una base de datos SQLite.
-- vacio --
-- fichero --
No es un directorio.
-- fichero.original --
No es un directorio.
