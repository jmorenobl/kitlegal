# Un ~/.claude/skills/boe-legislacion que dejó la instalación anterior —un
# enlace absoluto al skills/boe-legislacion de un clon, aquí el de la copia
# $WORK/repo, cuyo destino existe— es un conflicto: `make install` termina con
# código distinto de 0 nombrándolo como «enlace a otro sitio», y no toca
# ~/.agents ni ~/.claude ni escribe nada a través del enlace (FR-125, FR-126;
# contracts/skills-e-invocacion.md §5; caso límite «Enlaces antiguos de
# `make install`» del spec).
#
# HOME, GOBIN y GOPATH son carpetas de $WORK y el árbol es la copia mínima de
# $WORK/repo (FR-055 de H5; contrato instalacion §4 de H5).

mkdir $HOME/.claude/skills
symlink $HOME/.claude/skills/boe-legislacion -> $WORK/repo/skills/boe-legislacion
exec ls -A $WORK/repo/skills/boe-legislacion
cp stdout skill-del-clon.txt
cp $WORK/repo/skills/boe-legislacion/SKILL.md SKILL-del-clon.md

! exec make -C $WORK/repo install
stderr '^skills install: nada se ha creado ni cambiado; conflictos:$'
stderr '^enlace a otro sitio: '${WORK@R}'/home/\.claude/skills/boe-legislacion$'

# Nada en ~/.agents, y ~/.claude sigue con el único enlace y su destino. El
# resto de HOME no se mira: el go command escribe en él su configuración, como
# ~/Library en macOS.
! exists $HOME/.agents
exec ls -A $HOME/.claude
stdout '\Askills\n\z'
exec ls -A $HOME/.claude/skills
stdout '\Aboe-legislacion\n\z'
exec readlink $HOME/.claude/skills/boe-legislacion
stdout '\A'${WORK@R}'/repo/skills/boe-legislacion\n\z'

# Y nada se ha escrito a través del enlace: la skill del clon tiene las mismas
# entradas y el mismo SKILL.md.
exec ls -A $WORK/repo/skills/boe-legislacion
cmp stdout skill-del-clon.txt
cmp $WORK/repo/skills/boe-legislacion/SKILL.md SKILL-del-clon.md
