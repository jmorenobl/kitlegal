# Instalación en limpio: `make install` deja el binario en el directorio de
# binarios de Go y, con ese binario recién instalado, instala las skills en
# global: las tres skills y su manifiesto en ~/.agents/skills/ y un enlace
# relativo por skill en ~/.claude/skills/, con el destino literal
# ../../.agents/skills/<skill>; y no crea bin/instalado/ (US2 escenario 3,
# FR-125, FR-126, SC-018; contracts/skills-e-invocacion.md §5).
#
# El árbol es la copia mínima del repositorio que Setup deja en $WORK/repo, y
# HOME, GOBIN y GOPATH son carpetas de $WORK: nada de lo que hace este guion
# alcanza el directorio personal, el de binarios ni el árbol de quien ejecuta
# los tests (FR-055 de H5; contrato instalacion §4 de H5).

# Antes de instalar no hay nada en el directorio personal: ni el directorio
# neutro ni el del host, que crea la propia instalación con --host claude.
! exists $HOME/.agents
! exists $HOME/.claude

exec make -C $WORK/repo install

# El binario queda en el GOBIN temporal, y la receta no crea bin/instalado/
# (FR-125).
exists $WORK/gobin/kitlegal
! exists $WORK/repo/bin/instalado

# En ~/.agents/skills/, las tres skills y el manifiesto, y nada más (FR-126,
# SC-018).
exec ls -A $HOME/.agents/skills
stdout '\Aboe-legislacion\njurisprudencia\nkitlegal\.json\nlegal-core\n\z'

# En ~/.claude/skills/, un enlace relativo por skill con el destino literal
# ../../.agents/skills/<skill>, y nada más (FR-126, SC-018).
exec ls -A $HOME/.claude/skills
stdout '\Aboe-legislacion\njurisprudencia\nlegal-core\n\z'
exec readlink $HOME/.claude/skills/boe-legislacion
stdout '\A\.\./\.\./\.agents/skills/boe-legislacion\n\z'
exec readlink $HOME/.claude/skills/jurisprudencia
stdout '\A\.\./\.\./\.agents/skills/jurisprudencia\n\z'
exec readlink $HOME/.claude/skills/legal-core
stdout '\A\.\./\.\./\.agents/skills/legal-core\n\z'

# Y el SKILL.md instalado de cada skill es, byte a byte, el del árbol del que
# se compiló el binario (FR-126).
cmp $HOME/.agents/skills/boe-legislacion/SKILL.md $WORK/repo/skills/boe-legislacion/SKILL.md
cmp $HOME/.agents/skills/jurisprudencia/SKILL.md $WORK/repo/skills/jurisprudencia/SKILL.md
cmp $HOME/.agents/skills/legal-core/SKILL.md $WORK/repo/skills/legal-core/SKILL.md
