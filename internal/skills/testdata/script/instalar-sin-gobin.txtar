# Sin GOBIN, `make install` deja el binario en el directorio de binarios por
# defecto de Go, el `bin` de GOPATH, y la instalación sigue funcionando: el
# enlace del binario instalado nombra ese destino y `scripts/boe` responde
# (FR-050, FR-051; caso límite «`make install` sin `$GOBIN` definido» del spec).
#
# GOPATH es la carpeta de $WORK que fija Setup, así que tampoco aquí se alcanza
# el directorio de binarios real (FR-055; contrato instalacion §4).

env GOBIN=

exec make -C $WORK/repo install

exists $WORK/gopath/bin/kitlegal
! exists $WORK/gobin/kitlegal

exec readlink $WORK/repo/bin/instalado/kitlegal
stdout '\A'${WORK@R}'/gopath/bin/kitlegal\n\z'

exec $HOME/.claude/skills/boe-legislacion/scripts/boe articulo BOE-A-2015-10565 a21 --describe
stdout '"title": "boe articulo"'
! stderr .
