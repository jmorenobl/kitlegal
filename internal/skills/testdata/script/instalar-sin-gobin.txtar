# Sin GOBIN, `make install` deja el binario en el directorio de binarios por
# defecto de Go, el bin de GOPATH, y las skills se instalan igual: la receta
# ejecuta el binario por la ruta que da `go list -f '{{.Target}}'`, que es esa
# (FR-125, FR-126; contracts/skills-e-invocacion.md §5; caso límite
# «`make install` sin `$GOBIN` definido» del spec de H5).
#
# GOPATH es la carpeta de $WORK que fija Setup, así que tampoco aquí se alcanza
# el directorio de binarios real (FR-055 de H5; contrato instalacion §4 de H5).

env GOBIN=

exec make -C $WORK/repo install

exists $WORK/gopath/bin/kitlegal
! exists $WORK/gobin/kitlegal
! exists $WORK/repo/bin/instalado

exec ls -A $HOME/.agents/skills
stdout '\Aconsulta-juridica\njurisprudencia\nkitlegal\.json\nnormativa\nplazos-y-territorio\n\z'
exec readlink $HOME/.claude/skills/normativa
stdout '\A\.\./\.\./\.agents/skills/normativa\n\z'
exec readlink $HOME/.claude/skills/consulta-juridica
stdout '\A\.\./\.\./\.agents/skills/consulta-juridica\n\z'
exec readlink $HOME/.claude/skills/jurisprudencia
stdout '\A\.\./\.\./\.agents/skills/jurisprudencia\n\z'
exec readlink $HOME/.claude/skills/plazos-y-territorio
stdout '\A\.\./\.\./\.agents/skills/plazos-y-territorio\n\z'
cmp $HOME/.agents/skills/plazos-y-territorio/SKILL.md $WORK/repo/skills/plazos-y-territorio/SKILL.md
