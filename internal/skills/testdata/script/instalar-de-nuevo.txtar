# Repetir la instalación termina con 0 y no cambia nada: la segunda
# `make install` dice `sin cambios` para las dos skills, deja el manifiesto
# ~/.agents/skills/kitlegal.json byte a byte igual y los dos enlaces de
# ~/.claude/skills/ con su destino literal (FR-125, FR-126, SC-018;
# contracts/skills-e-invocacion.md §5). El detalle byte a byte de todo el árbol
# instalado lo cubre el guion de aceptación skills-idempotencia.
#
# HOME, GOBIN y GOPATH son carpetas de $WORK y el árbol es la copia mínima de
# $WORK/repo (FR-055 de H5; contrato instalacion §4 de H5).

exec make -C $WORK/repo install
cp $HOME/.agents/skills/kitlegal.json manifiesto-de-la-primera.json

exec make -C $WORK/repo install

# La salida de `kitlegal skills install` sin --json es una tabla de clave y
# valor, con una fila por campo de cada skill: la 0 es boe-legislacion y la 1,
# legal-core, las dos sin cambios.
stdout '^0\.nombre +boe-legislacion$'
stdout '^0\.estado +sin cambios$'
stdout '^1\.nombre +legal-core$'
stdout '^1\.estado +sin cambios$'
! stdout '\.estado +(?:instalada|actualizada)$'

cmp $HOME/.agents/skills/kitlegal.json manifiesto-de-la-primera.json

exec readlink $HOME/.claude/skills/boe-legislacion
stdout '\A\.\./\.\./\.agents/skills/boe-legislacion\n\z'
exec readlink $HOME/.claude/skills/legal-core
stdout '\A\.\./\.\./\.agents/skills/legal-core\n\z'
