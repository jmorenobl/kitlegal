# Go
/bin/
/dist/
*.test
/*.out
/coverage.*

# kitlegal runtime
.kitlegal/

# Web (ADR 0024): dependencias, salida de la construcción y caché de Astro
node_modules/
/web/dist/
/web/.astro/

# OS / editor
.DS_Store
.idea/
*.swp

# Logs de verificación del workflow (se regeneran en cada tarea)
specs/*/gates/ci.log

# Credenciales de Google (Search Console) por si alguna cae dentro del repositorio;
# su sitio es ~/.config/kitlegal/ (docs/SEO.md)
*service-account*.json
client_secret*.json

# Caché regenerable de spec-kit y worktrees de agente (nunca se versionan)
.specify/integrations/.cache/
.claude/worktrees/

# Bytecode de CPython: la única ejecución autorizada de refs/boe.py, fuera de todo gate,
# no deja rastro versionado
__pycache__/
