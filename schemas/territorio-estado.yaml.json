{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitlegal.es/schemas/territorio-estado.yaml.json",
  "title": "data/territorio/estado.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["fecha", "source", "boletin"],
  "properties": {
    "fecha": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "source": { "type": "string", "minLength": 1 },
    "boletin": { "$ref": "#/$defs/boletin" }
  },
  "$defs": {
    "boletin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codigo", "nombre", "url"],
      "properties": {
        "codigo": { "type": "string", "minLength": 1 },
        "nombre": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "minLength": 1 }
      }
    }
  }
}
