{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitlegal.es/schemas/territorio-dir3.yaml.json",
  "title": "data/territorio/dir3.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["fecha", "source", "correspondencia"],
  "properties": {
    "fecha": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "source": { "type": "string", "minLength": 1 },
    "correspondencia": {
      "type": "object",
      "propertyNames": { "pattern": "^(0[1-9]|[1-4][0-9]|5[0-2])(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$" },
      "additionalProperties": { "type": "string", "pattern": "^[Ll]01(0[1-9]|[1-4][0-9]|5[0-2])(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})[0-9]$" }
    }
  }
}
