{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitlegal.es/schemas/territorio-comunidad.yaml.json",
  "title": "data/territorio/comunidades/<código>.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["fecha", "source", "codigo", "nombre", "regimen", "provincias"],
  "properties": {
    "fecha": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "source": { "type": "string", "minLength": 1 },
    "codigo": { "type": "string", "pattern": "^[0-9]{2}$" },
    "nombre": { "type": "string", "minLength": 1 },
    "regimen": { "enum": ["comun", "foral"] },
    "provincias": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^(0[1-9]|[1-4][0-9]|5[0-2])$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "boletines": { "$ref": "#/$defs/boletines" }
  },
  "$defs": {
    "boletines": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "autonomico": { "$ref": "#/$defs/boletin" },
        "provincial": { "$ref": "#/$defs/boletin" }
      }
    },
    "boletin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codigo", "nombre", "url"],
      "properties": {
        "codigo": { "type": "string", "minLength": 1 },
        "nombre": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "minLength": 1 },
        "motivo": { "type": "string", "minLength": 1 }
      }
    }
  }
}
