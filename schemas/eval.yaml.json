{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitlegal.es/schemas/eval.yaml.json",
  "title": "evals/<skill>/<nn>-<descripción>.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["pregunta", "activa"],
  "properties": {
    "pregunta": { "type": "string", "minLength": 1 },
    "activa": { "type": "boolean" },
    "se_activan": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "no_se_activan": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "reproduce": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "informativa": { "type": "boolean" },
    "por_materia": {
      "type": "boolean",
      "description": "La pregunta no identifica lo que pregunta —ni el precepto ni la sentencia— y lo busca por su materia. Falso por omisión: el caso normal es que la pregunta nombre el precepto o la sentencia. Con él, la serie de cierres reparte las respuestas que marca el juez por clase de pregunta (ADR 0038, punto 6). No es informativa: una eval informativa puede nombrar el precepto."
    },
    "sin_binario_ni_servidor": { "const": true },
    "comandos": {
      "type": "array", "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/comando-bloque-esperado" },
          { "$ref": "#/$defs/comando-consulta-de-norma" },
          { "$ref": "#/$defs/comando-busqueda" },
          { "$ref": "#/$defs/comando-territorio" },
          { "$ref": "#/$defs/comando-comprobacion" },
          { "$ref": "#/$defs/comando-preparar" },
          { "$ref": "#/$defs/comando-cotejar" },
          { "$ref": "#/$defs/comando-calcular" }
        ]
      }
    },
    "prohibidos": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/comando-prohibido" }
    },
    "grafo_previo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grabaciones", "comandos"],
      "properties": {
        "grabaciones": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "comandos": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/comando-bloque" }
        }
      }
    },
    "citas": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/cita" }
    },
    "avisos": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/codigo-de-aviso" }
    },
    "hallazgos": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/clase-de-hallazgo" }
    },
    "redacciones_modificadas": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/redaccion-modificada" }
    },
    "territorio": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "comunidad": { "type": "string", "minLength": 1 },
        "provincia": { "type": "string", "minLength": 1 },
        "boletines": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "cobertura": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/aspecto-de-cobertura" } }
      }
    },
    "sentencias": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "not": { "required": ["citas", "ninguna_cita"] },
      "properties": {
        "citas": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ecli", "roj"],
            "properties": { "ecli": { "$ref": "#/$defs/ecli" }, "roj": { "$ref": "#/$defs/roj" } }
          }
        },
        "ninguna_cita": { "const": true },
        "sin_cita_del_roj": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/roj" } },
        "no_comprobada": { "const": true },
        "direcciones": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } },
        "casillas": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nombre", "valor"],
            "properties": {
              "nombre": { "type": "string", "minLength": 1 },
              "valor": { "type": "string", "minLength": 1 }
            }
          }
        },
        "direccion_de_busqueda": { "const": true }
      }
    },
    "plazo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fecha", "avisos", "razonamiento"],
      "properties": {
        "fecha": { "$ref": "#/$defs/dia" },
        "avisos": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/codigo-de-aviso-del-plazo" } },
        "razonamiento": { "type": "string", "minLength": 1 }
      }
    },
    "no_cubierto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["norma", "precepto"],
      "properties": {
        "norma": { "$ref": "#/$defs/norma" },
        "precepto": {
          "type": "object",
          "additionalProperties": false,
          "required": ["norma", "bloque"],
          "properties": { "norma": { "$ref": "#/$defs/norma" }, "bloque": { "$ref": "#/$defs/bloque" } }
        }
      }
    },
    "plazo_sin_calcular": {
      "type": "object",
      "additionalProperties": false,
      "required": ["norma"],
      "properties": { "norma": { "$ref": "#/$defs/norma" } }
    },
    "redaccion_fechada": {
      "type": "object",
      "additionalProperties": false,
      "required": ["norma", "bloque", "fecha"],
      "properties": {
        "norma": { "$ref": "#/$defs/norma" },
        "bloque": { "$ref": "#/$defs/bloque" },
        "fecha": { "$ref": "#/$defs/dia" },
        "fecha_vigencia": { "$ref": "#/$defs/fecha" },
        "posterior": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fecha_vigencia", "norma_modificadora"],
          "properties": {
            "fecha_vigencia": { "$ref": "#/$defs/fecha" },
            "norma_modificadora": { "$ref": "#/$defs/norma" }
          }
        },
        "vigente_desde": { "$ref": "#/$defs/fecha" }
      },
      "oneOf": [
        { "required": ["fecha_vigencia"], "not": { "required": ["vigente_desde"] } },
        {
          "required": ["vigente_desde"],
          "not": { "anyOf": [{ "required": ["fecha_vigencia"] }, { "required": ["posterior"] }] }
        }
      ]
    },
    "lecturas": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lectura" } },
    "sin_servir": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lectura-sin-servir" } }
  },
  "not": {
    "anyOf": [
      { "required": ["plazo", "no_cubierto"] }, { "required": ["plazo", "plazo_sin_calcular"] },
      { "required": ["no_cubierto", "plazo_sin_calcular"] }
    ]
  },
  "if": { "required": ["activa"], "properties": { "activa": { "const": true } } },
  "then": {
    "if": { "required": ["sin_binario_ni_servidor"] },
    "then": {
      "not": {
        "anyOf": [
          { "required": ["comandos"] }, { "required": ["prohibidos"] }, { "required": ["grafo_previo"] },
          { "required": ["citas"] }, { "required": ["avisos"] }, { "required": ["hallazgos"] },
          { "required": ["redacciones_modificadas"] }, { "required": ["territorio"] },
          { "required": ["informativa"] }, { "required": ["reproduce"] }, { "required": ["sentencias"] },
          { "required": ["por_materia"] }, { "required": ["plazo"] }, { "required": ["no_cubierto"] },
          { "required": ["plazo_sin_calcular"] }, { "required": ["redaccion_fechada"] }
        ]
      }
    },
    "else": {
      "if": { "anyOf": [{ "required": ["sentencias"] }, { "required": ["no_cubierto"] }] },
      "else": {
        "required": ["comandos"],
        "anyOf": [
          { "required": ["citas"] }, { "required": ["territorio"] }, { "required": ["plazo"] },
          { "required": ["plazo_sin_calcular"] }
        ]
      }
    }
  },
  "else": {
    "not": {
      "anyOf": [
        { "required": ["comandos"] }, { "required": ["prohibidos"] }, { "required": ["grafo_previo"] },
        { "required": ["citas"] }, { "required": ["avisos"] }, { "required": ["hallazgos"] },
        { "required": ["redacciones_modificadas"] }, { "required": ["territorio"] },
        { "required": ["sin_binario_ni_servidor"] }, { "required": ["sentencias"] }, { "required": ["por_materia"] },
        { "required": ["plazo"] }, { "required": ["no_cubierto"] }, { "required": ["plazo_sin_calcular"] },
        { "required": ["redaccion_fechada"] }
      ]
    }
  },
  "$defs": {
    "codigo-de-aviso": { "enum": ["consolidacion-no-finalizada", "derogada", "vigencia-agotada"] },
    "codigo-de-aviso-del-plazo": {
      "enum": [
        "faltan-festivos-nacionales-y-autonomicos", "faltan-festivos-locales", "dias-del-art-183-lopj",
        "festivo-de-una-parte"
      ]
    },
    "clase-de-hallazgo": { "enum": ["version-obsoleta"] },
    "aspecto-de-cobertura": {
      "enum": [
        "boletin_autonomico: configurado", "boletin_autonomico: no-configurado",
        "boletin_provincial: configurado", "boletin_provincial: no-configurado",
        "dir3: verificado", "dir3: no-verificado"
      ]
    },
    "applet": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "norma": { "type": "string", "pattern": "^BOE-A-[0-9]{4}-[0-9]{1,9}$" },
    "bloque": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,63}$" },
    "comando-bloque": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applet", "norma", "bloque"],
      "properties": {
        "applet": { "$ref": "#/$defs/applet" },
        "norma": { "$ref": "#/$defs/norma" },
        "bloque": { "$ref": "#/$defs/bloque" }
      }
    },
    "comando-bloque-esperado": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applet", "norma", "bloque"],
      "properties": {
        "applet": { "$ref": "#/$defs/applet" },
        "norma": { "$ref": "#/$defs/norma" },
        "bloque": { "$ref": "#/$defs/bloque" },
        "fecha": { "$ref": "#/$defs/dia" }
      }
    },
    "comando-consulta-de-norma": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applet", "verbo", "norma"],
      "properties": {
        "applet": { "$ref": "#/$defs/applet" },
        "verbo": { "enum": ["indice", "metadatos", "analisis"] },
        "norma": { "$ref": "#/$defs/norma" }
      }
    },
    "comando-busqueda": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applet", "verbo", "terminos"],
      "properties": {
        "applet": { "$ref": "#/$defs/applet" },
        "verbo": { "const": "buscar" },
        "terminos": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "comando-territorio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applet", "verbo", "municipio"],
      "properties": {
        "applet": { "$ref": "#/$defs/applet" },
        "verbo": { "const": "resolver" },
        "municipio": { "type": "string", "minLength": 1 }
      }
    },
    "comando-comprobacion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applet", "verbo"],
      "properties": {
        "applet": { "$ref": "#/$defs/applet" },
        "verbo": { "const": "check" },
        "norma": { "$ref": "#/$defs/norma" }
      }
    },
    "ecli": { "type": "string", "pattern": "^ECLI:ES:[A-Z][A-Z0-9]{0,6}:[0-9]{4}:[A-Z0-9.]{1,25}$" },
    "roj": { "type": "string", "pattern": "^[A-Z]+( [A-Z]+)* [0-9]+/[0-9]{4}$" },
    "comando-preparar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applet", "verbo"],
      "properties": {
        "applet": { "$ref": "#/$defs/applet" },
        "verbo": { "const": "preparar" },
        "roj": { "$ref": "#/$defs/roj" },
        "con_texto": { "const": true }
      }
    },
    "comando-cotejar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applet", "verbo"],
      "properties": {
        "applet": { "$ref": "#/$defs/applet" },
        "verbo": { "const": "cotejar" },
        "roj": { "$ref": "#/$defs/roj" }
      }
    },
    "comando-calcular": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applet", "verbo", "tipo"],
      "properties": {
        "applet": { "$ref": "#/$defs/applet" },
        "verbo": { "const": "calcular" },
        "tipo": { "type": "string", "minLength": 1 },
        "sin_calcular": { "const": true }
      }
    },
    "comando-prohibido": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applet", "verbo"],
      "properties": {
        "applet": { "$ref": "#/$defs/applet" },
        "verbo": { "type": "string", "pattern": "^[a-z]+$" }
      }
    },
    "cita": {
      "type": "object",
      "additionalProperties": false,
      "required": ["norma", "bloque"],
      "properties": {
        "norma": { "$ref": "#/$defs/norma" },
        "bloque": { "$ref": "#/$defs/bloque" }
      }
    },
    "redaccion-modificada": {
      "type": "object",
      "additionalProperties": false,
      "required": ["norma", "bloque", "fecha_vigencia", "fecha_vigencia_reciente"],
      "properties": {
        "norma": { "$ref": "#/$defs/norma" },
        "bloque": { "$ref": "#/$defs/bloque" },
        "fecha_vigencia": { "$ref": "#/$defs/fecha" },
        "fecha_vigencia_reciente": { "$ref": "#/$defs/fecha" }
      }
    },
    "lectura": {
      "type": "object",
      "additionalProperties": false,
      "required": ["norma", "bloque", "motivo"],
      "properties": {
        "norma": { "$ref": "#/$defs/norma" },
        "bloque": { "$ref": "#/$defs/bloque" },
        "motivo": { "type": "string", "pattern": "\\S" }
      }
    },
    "lectura-sin-servir": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["norma", "bloque"],
          "properties": { "norma": { "$ref": "#/$defs/norma" }, "bloque": { "$ref": "#/$defs/bloque" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["norma", "verbo"],
          "properties": { "norma": { "$ref": "#/$defs/norma" }, "verbo": { "enum": ["indice", "metadatos"] } }
        }
      ]
    },
    "fecha": { "type": "string", "pattern": "^[0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])$" },
    "dia": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" }
  }
}
