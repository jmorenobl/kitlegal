{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitlegal.es/schemas/eval.yaml.json",
  "title": "evals/<skill>/<nn>-<descripción>.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["pregunta", "activa"],
  "properties": {
    "pregunta": { "type": "string", "minLength": 1 },
    "activa": { "type": "boolean" },
    "reproduce": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "informativa": { "type": "boolean" },
    "comandos": {
      "type": "array", "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/comando-bloque" },
          { "$ref": "#/$defs/comando-consulta-de-norma" },
          { "$ref": "#/$defs/comando-busqueda" },
          { "$ref": "#/$defs/comando-territorio" },
          { "$ref": "#/$defs/comando-comprobacion" }
        ]
      }
    },
    "prohibidos": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/comando-prohibido" }
    },
    "grafo_previo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grabaciones", "comandos"],
      "properties": {
        "grabaciones": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "comandos": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/comando-bloque" }
        }
      }
    },
    "citas": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/cita" }
    },
    "avisos": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/codigo-de-aviso" }
    },
    "hallazgos": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/clase-de-hallazgo" }
    },
    "territorio": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "comunidad": { "type": "string", "minLength": 1 },
        "provincia": { "type": "string", "minLength": 1 },
        "boletines": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "cobertura": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/aspecto-de-cobertura" } }
      }
    }
  },
  "if": { "required": ["activa"], "properties": { "activa": { "const": true } } },
  "then": {
    "required": ["comandos"],
    "anyOf": [{ "required": ["citas"] }, { "required": ["territorio"] }]
  },
  "else": {
    "not": {
      "anyOf": [
        { "required": ["comandos"] }, { "required": ["prohibidos"] }, { "required": ["grafo_previo"] },
        { "required": ["citas"] }, { "required": ["avisos"] }, { "required": ["hallazgos"] },
        { "required": ["territorio"] }
      ]
    }
  },
  "$defs": {
    "codigo-de-aviso": { "enum": ["consolidacion-no-finalizada", "derogada", "vigencia-agotada"] },
    "clase-de-hallazgo": { "enum": ["version-obsoleta"] },
    "aspecto-de-cobertura": {
      "enum": [
        "boletin_autonomico: configurado", "boletin_autonomico: no-configurado",
        "boletin_provincial: configurado", "boletin_provincial: no-configurado",
        "dir3: verificado", "dir3: no-verificado"
      ]
    },
    "applet": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "norma": { "type": "string", "pattern": "^BOE-A-[0-9]{4}-[0-9]{1,9}$" },
    "bloque": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,63}$" },
    "comando-bloque": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applet", "norma", "bloque"],
      "properties": {
        "applet": { "$ref": "#/$defs/applet" },
        "norma": { "$ref": "#/$defs/norma" },
        "bloque": { "$ref": "#/$defs/bloque" }
      }
    },
    "comando-consulta-de-norma": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applet", "verbo", "norma"],
      "properties": {
        "applet": { "$ref": "#/$defs/applet" },
        "verbo": { "enum": ["indice", "metadatos", "analisis"] },
        "norma": { "$ref": "#/$defs/norma" }
      }
    },
    "comando-busqueda": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applet", "verbo", "terminos"],
      "properties": {
        "applet": { "$ref": "#/$defs/applet" },
        "verbo": { "const": "buscar" },
        "terminos": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "comando-territorio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applet", "verbo", "municipio"],
      "properties": {
        "applet": { "$ref": "#/$defs/applet" },
        "verbo": { "const": "resolver" },
        "municipio": { "type": "string", "minLength": 1 }
      }
    },
    "comando-comprobacion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applet", "verbo"],
      "properties": {
        "applet": { "$ref": "#/$defs/applet" },
        "verbo": { "const": "check" },
        "norma": { "$ref": "#/$defs/norma" }
      }
    },
    "comando-prohibido": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applet", "verbo"],
      "properties": {
        "applet": { "$ref": "#/$defs/applet" },
        "verbo": { "type": "string", "pattern": "^[a-z]+$" }
      }
    },
    "cita": {
      "type": "object",
      "additionalProperties": false,
      "required": ["norma", "bloque"],
      "properties": {
        "norma": { "$ref": "#/$defs/norma" },
        "bloque": { "$ref": "#/$defs/bloque" }
      }
    }
  }
}
