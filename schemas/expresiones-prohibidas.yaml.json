{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitlegal.es/schemas/expresiones-prohibidas.yaml.json",
  "title": "evals/<skill>/expresiones-prohibidas.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["maquinaria", "otra_conversacion", "anuncio", "redaccion_no_leida", "formas_fijas"],
  "properties": {
    "maquinaria": { "$ref": "#/$defs/expresiones" },
    "otra_conversacion": { "$ref": "#/$defs/expresiones" },
    "anuncio": { "$ref": "#/$defs/expresiones" },
    "redaccion_no_leida": { "$ref": "#/$defs/expresiones" },
    "formas_fijas": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "pattern": "^[^\\n]*[^\\s<>][^\\n]*$" }
    }
  },
  "$defs": {
    "expresiones": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "pattern": "^[^\\s*_]+( [^\\s*_]+)*$" }
    }
  }
}
