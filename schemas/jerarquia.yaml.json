{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ventanillalegal.es/schemas/jerarquia.yaml.json",
  "title": "data/jerarquia.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["niveles", "reglas"],
  "properties": {
    "niveles": {
      "type": "array",
      "minItems": 5,
      "prefixItems": [
        { "$ref": "#/$defs/nivel", "properties": { "nivel": { "const": "ue" } } },
        { "$ref": "#/$defs/nivel", "properties": { "nivel": { "const": "estado" } } },
        { "$ref": "#/$defs/nivel", "properties": { "nivel": { "const": "comunidad-autonoma" } } },
        { "$ref": "#/$defs/nivel", "properties": { "nivel": { "const": "provincia" } } },
        { "$ref": "#/$defs/nivel", "properties": { "nivel": { "const": "municipio" } } }
      ],
      "items": false
    },
    "reglas": {
      "type": "array",
      "minItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/regla", "properties": { "regla": { "const": "competencia-antes-que-jerarquia" } } },
        { "$ref": "#/$defs/regla", "properties": { "regla": { "const": "ley-posterior" } } },
        { "$ref": "#/$defs/regla", "properties": { "regla": { "const": "ley-especial" } } },
        { "$ref": "#/$defs/regla", "properties": { "regla": { "const": "reglamento-nunca-contra-ley" } } }
      ],
      "items": false
    }
  },
  "$defs": {
    "nivel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nivel", "nombre", "boletin", "normas"],
      "properties": {
        "nivel": { "enum": ["ue", "estado", "comunidad-autonoma", "provincia", "municipio"] },
        "nombre": { "type": "string", "minLength": 1 },
        "boletin": { "type": "string", "minLength": 1 },
        "normas": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "regla": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regla", "enunciado"],
      "properties": {
        "regla": {
          "enum": ["competencia-antes-que-jerarquia", "ley-posterior", "ley-especial", "reglamento-nunca-contra-ley"]
        },
        "enunciado": { "type": "string", "minLength": 1 }
      }
    }
  }
}
